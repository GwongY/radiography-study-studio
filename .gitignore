.superpowers/
_skel-names.txt

# Local full-text cache of the source drive (work/build-source-text.mjs --all).
# ~29 MB of extracted text, rebuildable, and only useful on a machine that has
# the drive mounted. The CITED sources are committed, in work/source-text.json.
work/.source-text/

# Local New/old source-to-lesson audit; may contain private filenames.
work/.source-lesson-audit/

# Course source material. Copyrighted lecture decks and textbooks that are not
# ours to publish, and this repository is public — 47 MB of them sit in
# "New source/" alone. They are catalogued and their text is indexed
# (work/source-catalogue.json, work/.source-text/), which is what the app needs;
# the files themselves stay out.
New source/

# Automated review-hook state (PostToolUse). Baseline snapshots of every file
# an edit touched, content-hashed, plus its run reports and finding ledger —
# 47 MB across ten sessions, and it grows with every edit. Local tooling state,
# rebuilt on demand, and nothing in the app or the verifiers reads it.
.mimosa/

# Offline copy of the old sources (E:\UNI sources). Copyrighted, public repo.
UNI sources/

# Private runtime secrets and mail.
private-app/.env
private-app/.data/
private-app/*.vault
private-app/*.vault.*
private-app/.test-data/

# Retired local prototype and private hosting checkout.
work/.retired-private-mail/
.sites-private/

# Weekly briefing plaintext (work/weekly-briefing.mjs). Real email; this repo is public.
work/.briefing/

# Prompts that name the owner's mailbox. Local only; this repo is public.
private-prompts/

# Check-only tooling installed by `npm ci --prefix work/lint` (work/undef-check.mjs).
node_modules/

# Cell zoom model build: unzipped CC BY downloads and the intermediate .glb files between
# work/build-cell-models.mjs and Blender (work/blender/). Rebuildable; only outputs/cell/models/ ships.
work/.cell-build/

# Python bytecode from running work/blender/ in Blender
__pycache__/
