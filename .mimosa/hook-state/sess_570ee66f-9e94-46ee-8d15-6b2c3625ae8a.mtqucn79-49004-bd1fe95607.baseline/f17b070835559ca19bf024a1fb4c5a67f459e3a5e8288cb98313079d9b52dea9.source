export function memoryTip(word) {
  const w = String(word || '').toLowerCase().replace(/[^a-z]/g, '');
  if (MEMORY_TIPS[w]) return MEMORY_TIPS[w];
  for (const [from, to] of [[/i$/, 'us'], [/ae$/, 'a'], [/es$/, 'e'], [/s$/, ''], [/al$/, ''], [/ic$/, '']]) {
    const alt = w.replace(from, to);
    if (alt !== w && MEMORY_TIPS[alt]) return MEMORY_TIPS[alt];
  }
  return null;
}

