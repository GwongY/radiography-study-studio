  telencephalon: 'TEL-encephalon is the endbrain: the cerebral hemispheres and related structures.',
  mesencephalon: 'MES-encephalon is the midbrain: mes = middle, encephalon = brain.',
  metencephalon: 'MET-encephalon is the hindbrain division that gives rise to pons and cerebellum.',
  myelencephalon: 'MYEL-encephalon becomes the medulla; myel means marrow or medulla.',
  prosencephalon: 'PROS-encephalon is the forebrain: pros = before or in front.',
  rhombencephalon: 'RHOMB-encephalon is the hindbrain; rhomb = diamond-shaped.',
  meninges: 'MENINGES are the three protective membranes around the brain and spinal cord.',
  dura: 'DURA is the tough outer meningeal layer; dura means hard.',
  pia: 'PIA is the delicate inner meningeal layer pressed against the nervous tissue.',
  chiasm: 'CHIASM is a crossing; the optic chiasm is where some visual fibres cross.',
  decussation: 'DECUSSATION is a crossing from one side of the nervous system to the other.',
  fasciculus: 'FASCICULUS is a small bundle of nerve fibres.',
  peduncle: 'PEDUNCLE is a stalk-like bundle connecting a brain region to another.',
  corticospinal: 'CORTICO-SPINAL runs from cerebral cortex to spinal cord.',
  spinothalamic: 'SPINO-THALAMIC runs from spinal cord toward the thalamus.',
  macula: 'MACULA is a spot or patch; in the eye it is the central area for sharp vision.',
  utricle: 'UTRICLE is a small sac in the vestibule that senses head tilt and linear motion.',
  saccule: 'SACCULE is a small sac beside the utricle that senses vertical linear motion.',
  pylorus: 'PYLORUS is the stomach’s gatekeeper at its exit into the duodenum.',
  gallbladder: 'GALLBLADDER is the small bile-storage sac tucked under the liver.',
  detrusor: 'DETRUSOR is the bladder muscle that squeezes urine out; detrusor = driving down.',
  epididymis: 'EPIDIDYMIS is the long coiled tube on the back of a testis where sperm mature.',
  fimbriae: 'FIMBRIAE are fringe-like ends of the uterine tubes near an ovary.',
  endometrium: 'ENDO-METRIUM is the inner lining of the uterus: endo = within.',
  myometrium: 'MYO-METRIUM is the muscle layer of the uterus: myo = muscle.',
  cervix: 'CERVIX is the neck-like lower part of the uterus opening into the vagina.',
  prostate: 'PROSTATE is the gland below the bladder surrounding the first urethral segment.',
  perineum: 'PERI-neum is the floor-region between the external genitalia and anus.',
  sella: 'SELLA is a saddle-shaped hollow in the sphenoid bone.',
  turcica: 'TURCica means Turkish saddle; sella turcica cradles the pituitary gland.',
  crista: 'CRISTA is a crest or ridge; crista galli is a midline skull projection.',
  mastoid: 'MASToid means breast-shaped; the mastoid process sits behind the ear.',
  nuchal: 'NUCHal belongs to the nape of the neck.',
  odontoid: 'ODONToid is tooth-like; the dens is the tooth-shaped part of the axis.',
  dens: 'DENS means tooth; the dens of C2 acts as the pivot for the atlas.',
  atlas: 'ATLAS is C1, the neck bone that holds up the skull like the mythic Atlas.',
  axis: 'AXIS is C2, the neck bone that provides the turning pivot.',
  corpus: 'CORPUS means body; corpus callosum is the body-like bridge between hemispheres.',
  callosum: 'CALLOSUM means tough or hard; corpus callosum is the tough fibre bridge between hemispheres.',
  choroid: 'CHOROID is the vascular eye layer; remember “choroid = colour and blood supply”.',
  hypophysis: 'HYPOPHysis sits below the brain and is another name for the pituitary gland.',
  adenohypophysis: 'ADENO-HYPOPHYSIS is the glandular pituitary: adeno = gland, hypo = below.',
  neurohypophysis: 'NEURO-HYPOPHYSIS is the neural pituitary: neuro = nerve, hypo = below.',
  diencephalon: 'DIENCEPHALON is the “between-brain” around the thalamus and hypothalamus.',
  medulla: 'MEDULLA is the inner core; the medulla oblongata is the lower brainstem core.',
  oblongata: 'OBLONGATA means elongated; medulla oblongata is the elongated lower brainstem.',
  ventricle: 'VENTRICLE is a small cavity; in the brain it holds cerebrospinal fluid.',
  cerebral: 'CEREBRAL belongs to the cerebrum, the large thinking part of the brain.',
  cerebellar: 'CEREBELLAR belongs to the cerebellum, the small brain for coordination.',
  arachnoid: 'ARACHNOID is spider-web-like, the middle meningeal layer.',
  meningeal: 'MENINGEAL means belonging to the meninges, the protective brain coverings.',
  subarachnoid: 'SUB-ARACHNOID is beneath the arachnoid layer; CSF flows there.',
  trochlear: 'TROCHLEAR belongs to the pulley-like fourth cranial nerve, which moves an eye muscle.',
  trigeminal: 'TRI-GEMINAL has three main branches: tri = three, geminal = twin-like.',
  accessory: 'ACCESSORY is the eleventh cranial nerve, assisting head and shoulder movement.',
  subclavius: 'SUB-CLAVIUS lies under the clavicle: sub = under, clavi = collarbone.',
  rotatores: 'ROTATORES rotate; these small deep back muscles turn the vertebral column.',
  semispinalis: 'SEMI-SPINALIS is partly spinal; it runs from transverse processes toward the spine.',
  longissimus: 'LONGISSIMUS means longest; it is the long column of the erector spinae group.',
  iliocostalis: 'ILIO-COSTALIS runs from ilium to ribs: ilio = ilium, costal = rib.',
  transversospinalis: 'TRANSVERSO-SPINALIS runs from transverse processes toward the spine.',
  erector: 'ERECTOR raises or extends; erector spinae helps extend the vertebral column.',
  spinae: 'SPINAE means “of the spine”; erector spinae is the spine-extending muscle group.',
  infundibulum: 'INFUNDIBULUM is a funnel-shaped passage; several organs use this name.',
  ampulla: 'AMPULLA is a widened flask-like section of a tube.',
  isthmus: 'ISTHMUS is a narrow bridge joining two wider regions.',
  trigone: 'TRIGONE is a triangular area; the bladder trigone lies between three openings.',
  ileocecal: 'ILEO-CECAL joins the ileum to the caecum.',
  hepatopancreatic: 'HEPATO-PANCREATIC joins liver and pancreas through their shared duct region.',
  sphincter: 'SPHINCTER is a ring muscle that closes an opening.',
  papilla: 'PAPILLA is a small nipple-like projection; renal papillae drain urine.',
  duodenal: 'DUODENAL belongs to the duodenum, the first small-intestine segment.',
  sclera: 'SCLERA is the tough white outer coat of the eye.',
  tympanum: 'TYMPANUM is the eardrum; think of a tympanic drum.',
  malleus: 'MALLEUS is the hammer-shaped first ear ossicle.',
  incus: 'INCUS is the anvil-shaped middle ear ossicle.',
  stapes: 'STAPES is the stirrup-shaped final ear ossicle.',
  ossicles: 'OSSICLES are little bones; the ear ossicles are malleus, incus, and stapes.',
  vestibule: 'VESTIBULE is an entrance hall; the inner-ear vestibule links cochlea and canals.',
  bregma: 'BREGMA is the “front roof” meeting point of the coronal and sagittal sutures.',
  lambda: 'LAMBDA is the rear skull meeting point; its sutures make a Greek lambda-like shape.',
  pterion: 'PTERION is the wing-shaped junction on the side of the skull.',
  asterion: 'ASTERION is the star-like junction behind the ear; aster = star.',
  squamous: 'SQUAMOUS means flat and scale-like; the squamous temporal bone is thin and broad.',
  nasal: 'NASAL belongs to the nose or nasal cavity.',
  maxillary: 'MAXILLARY belongs to the maxilla, the upper jaw.',
  mandibular: 'MANDIBULAR belongs to the mandible, the lower jaw.',
  endosteum: 'ENDOSTEUM lines the inside of bone: endo = within, oste = bone.',
  osteon: 'OSTEON is the basic cylindrical unit of compact bone.',
  lamellae: 'LAMELLAE are thin layers of bone arranged around an osteon.',
  lacunae: 'LACUNAE are little spaces in bone matrix where osteocytes sit.',
  canaliculi: 'CANALICULI are tiny channels linking lacunae through solid bone.',
  osteocyte: 'OSTEOcyte is a mature bone cell living in a lacuna.',
  supraorbital: 'SUPRA-ORBITAL is above the eye socket: supra = above, orbital = orbit.',
  infraorbital: 'INFRA-ORBITAL is below the eye socket: infra = below.',
  mental: 'MENTAL belongs to the chin, not the mind; the mental foramen is in the mandible.',
  jugular: 'JUGULAR belongs to the neck; jugular veins drain blood from the head.',
  carotid: 'CAROTID arteries supply the neck and brain; the name is linked with “sleepy”.',
  magnum: 'MAGNUM means large; foramen magnum is the large opening in the skull base.',
  stylomastoid: 'STYLO-MASTOID lies between the styloid and mastoid processes.',
  spinosum: 'SPINOSUM is spine-like; foramen spinosum is a small sharp-edged opening.',
  ovale: 'OVALE means oval; foramen ovale is the oval skull opening.',
  rotundum: 'ROTUNDUM means round; foramen rotundum is the round skull opening.',
  lacerum: 'LACERUM means torn; foramen lacerum is the “torn” irregular opening.',
  orbital: 'ORBITAL belongs to the orbit, the bony eye socket.',
  piriformis: 'PIRIFORMIS is pear-shaped: piri = pear, formis = shape.',
  gemellus: 'GEMELLUS means little twin; the gemelli are paired hip muscles.',
  quadratusfemoris: 'QUADRATUS-FEMORIS is the square muscle of the femur region.',
  obturatorinternus: 'OBTURATOR-INTERNUS is the inside obturator muscle; internus = internal.',
  obturatorexternus: 'OBTURATOR-EXTERNUS is the outside obturator muscle; externus = external.',
  iliotibial: 'ILIO-TIBIAL runs from the ilium toward the tibia, as in the iliotibial tract.',
  interossei: 'INTEROSSEI lie between bones: inter = between, ossei = bony.',
  lumbricals: 'LUMBRICALS are worm-like hand or foot muscles; lumbricus = earthworm.',
  thenar: 'THENAR is the fleshy thumb-side mound of the palm.',
  hypothenar: 'HYPOTHENAR is the fleshy little-finger-side mound of the palm.',
  opponens: 'OPPONENS brings the thumb into opposition, across toward the fingers.',
  abductorpollicis: 'ABDUCTOR-POLLICIS moves the thumb away: abductor + pollex, thumb.',
  flexorcarpi: 'FLEXOR-CARPI bends the wrist: flexor + carpus, wrist.',
  extensorcarpi: 'EXTENSOR-CARPI straightens the wrist: extensor + carpus, wrist.',
  metacarpophalangeal: 'META-CARPO-PHALANGEAL joins palm bones to finger bones.',
  interphalangeal: 'INTER-PHALANGEAL lies between phalanges, the finger or toe bones.',
  talocalcaneal: 'TALO-CALCANEAL joins the talus to the calcaneus at the subtalar region.',
  calcaneocuboid: 'CALCANEO-CUBOID joins the heel bone to the cuboid.',
  tarsometatarsal: 'TARSO-METATARSAL joins a tarsal to a metatarsal.',
  intertarsal: 'INTER-TARSAL lies between tarsal bones.',
  radiocarpal: 'RADIO-CARPAL joins the radius to the wrist at the wrist joint.',
  septum: 'SEPTUM is a partition dividing one space into two.',
  auricle: 'AURICLE is a little ear; it can mean the external ear or an atrial appendage.',
  trabeculae: 'TRABECULAE are little beams or struts; spongy bone is a trabecular lattice.',
  carneae: 'CARNEAE means fleshy; trabeculae carneae are fleshy ridges inside ventricles.',
  aortic: 'AORTIC belongs to the aorta, the body’s main artery.',
  mitral: 'MITRAL is the left atrioventricular valve; its two cusps resemble a bishop’s mitre.',
  tricuspid: 'TRICUSPID has three cusps: tri = three, cuspid = point.',
  substantia: 'SUBSTANTIA means substance; substantia nigra is a dark brain region.',
  nigra: 'NIGRA means black; substantia nigra is the black-pigmented brain region.',
  caudate: 'CAUDATE means tail-like; the caudate nucleus has a curved tail.',
  putamen: 'PUTAMEN is a shell-like deep brain nucleus; putamen means shell or husk.',
  aqueduct: 'AQUEDUCT is a water channel; the cerebral aqueduct carries cerebrospinal fluid.',
  bulb: 'BULB is a rounded swelling; the olfactory bulb receives smell signals.',
  tract: 'TRACT is a bundle or pathway; a nervous tract carries fibres together.',
  bowman: 'BOWMAN refers to the capsule surrounding a glomerulus at the start of a nephron.',
  collecting: 'COLLECTING belongs to the collecting duct, which gathers urine from nephrons.',
  duct: 'DUCT is a tube carrying a secretion or fluid.',
  seminal: 'SEMINAL belongs to semen or seed; seminal vesicles add fluid to semen.',
  vesicle: 'VESICLE is a small sac or bubble-like compartment.',
  vas: 'VAS means vessel or duct; the vas deferens carries sperm away.',
  deferens: 'DEFERENS means carrying away; vas deferens carries sperm from the epididymis.',
  ovary: 'OVARY is the female gonad that stores and releases oocytes.',
  oviduct: 'OVIDUCT is the tube carrying an ovum; in humans it is the uterine tube.',
  omentum: 'OMENTUM is a fatty apron-like fold of peritoneum over the abdominal organs.',
  pancreatic: 'PANCREATIC belongs to the pancreas, which has digestive and endocrine roles.',
  anal: 'ANAL belongs to the anus, the terminal opening of the digestive tract.',
  canal: 'CANAL is a passage or tunnel through a body structure.',
  cricoid: 'CRICOID is ring-shaped; the cricoid cartilage forms the lower laryngeal ring.',
  arytenoid: 'ARYTENOID is ladle-shaped; paired arytenoid cartilages anchor vocal folds.',
  vocal: 'VOCAL belongs to voice or the vocal folds of the larynx.',
  folds: 'FOLDS are paired tissue ridges; vocal folds vibrate to make sound.',
  laryngeal: 'LARYNGEAL belongs to the larynx, the voice box.',
  bronchial: 'BRONCHIAL belongs to the bronchi, the main branches of the airway.',
  lymph: 'LYMPH is the clear fluid carried through lymphatic vessels and nodes.',
  node: 'A NODE is a small knot; a lymph node filters lymph and supports immune defence.',
  thymic: 'THYMIC belongs to the thymus, the T-cell maturation organ.',
  urethral: 'URETHRAL belongs to the urethra, the tube carrying urine out of the body.',
  renalpelvis: 'RENAL-PELVIS is the funnel-like urine-collecting space inside the kidney.',
  tympanic: 'TYMPANIC belongs to the eardrum or middle-ear cavity.',
  auditory: 'AUDITORY belongs to hearing or the ear.',
  olfactory: 'OLFACTORY belongs to smell and the olfactory nerve or bulb.',
  optic: 'OPTIC belongs to sight and the optic nerve or pathway.',
  facial: 'FACIAL belongs to the face or the seventh cranial nerve.',
  vagus: 'VAGUS means wandering; the vagus nerve travels widely through chest and abdomen.',
  annulus: 'ANNULUS is a ring; the annulus fibrosus is the tough outer disc ring.',
  pulposus: 'PULPOSUS means pulpy; nucleus pulposus is the soft centre of a disc.',
  meniscus: 'MENISCUS is a crescent-shaped cartilage pad in the knee.',
  labrum: 'LABRUM is a rim or lip of cartilage deepening a joint socket.',
  retinaculum: 'RETINACULUM is a retaining band that holds tendons close to a joint.',
  enthesis: 'ENTHESIS is the attachment site where tendon or ligament meets bone.',
  synovium: 'SYNOVIUM is the joint lining that helps make synovial fluid.',
  cribriform: 'CRIBRIFORM means sieve-like; the cribriform plate lets smell fibres pass.',
  incisive: 'INCISIVE belongs to the incisor region at the front of the jaw.',
  ethmoidal: 'ETHMOIDAL belongs to the ethmoid bone between the eyes.',
  vertebrosternal: 'VERTEBRO-STERNAL runs from vertebra to sternum; true ribs are vertebrosternal.',
  vertebrochondral: 'VERTEBRO-CHONDRAL runs from vertebra to cartilage; false ribs are vertebrochondral.',
  teresmajor: 'TERES-MAJOR is the larger round muscle from scapula toward the upper arm.',
  teresminor: 'TERES-MINOR is the smaller round rotator-cuff muscle.',
  pectoralismajor: 'PECTORALIS-MAJOR is the large chest muscle; major = larger.',
  pectoralisminor: 'PECTORALIS-MINOR is the smaller chest muscle deep to pectoralis major.',
  pronatorquadratus: 'PRONATOR-QUADRATUS is the square muscle that turns the palm down.',
  pronatorteres: 'PRONATOR-TERES is the round pronating muscle crossing the forearm.',
  flexordigitorum: 'FLEXOR-DIGITORUM bends the digits: flexor = bend, digitorum = fingers/toes.',
  extensordigitorum: 'EXTENSOR-DIGITORUM straightens the digits: extensor = straighten.',
  palmaris: 'PALMARIS belongs to the palm; palmaris longus runs toward the palm.',
  flexorpollicis: 'FLEXOR-POLLICIS bends the thumb: pollex = thumb.',
  extensorpollicis: 'EXTENSOR-POLLICIS straightens the thumb: pollex = thumb.',
  adductorpollicis: 'ADDUCTOR-POLLICIS brings the thumb toward the hand.',
  opponenspollicis: 'OPPONENS-POLLICIS brings the thumb across the palm to oppose the fingers.',
  gluteusmaximus: 'GLUTEUS-MAXIMUS is the largest buttock muscle; maximus = biggest.',
  gluteusmedius: 'GLUTEUS-MEDIUS is the middle buttock muscle.',
  gluteusminimus: 'GLUTEUS-MINIMUS is the smallest and deepest buttock muscle.',
  tensorfasciaelatae: 'TENSOR-FASCIAE-LATAE tightens the broad thigh fascia.',
  tibialisanterior: 'TIBIALIS-ANTERIOR lies beside the tibia at the front of the leg.',
  tibialisposterior: 'TIBIALIS-POSTERIOR lies beside the tibia at the back of the leg.',
  flexordigitorumlongus: 'FLEXOR-DIGITORUM-LONGUS is the long toe-bending muscle.',
  extensordigitorumlongus: 'EXTENSOR-DIGITORUM-LONGUS is the long toe-straightening muscle.',
  flexorhallucislongus: 'FLEXOR-HALLUCIS-LONGUS bends the great toe: hallucis = great toe.',
  extensorhallucislongus: 'EXTENSOR-HALLUCIS-LONGUS straightens the great toe.',
  peroneuslongus: 'PERONEUS-LONGUS is the long muscle along the fibular side of the leg.',
  peroneusbrevis: 'PERONEUS-BREVIS is the short fibular-side muscle: brevis = short.',
  pectineus: 'PECTINEUS is comb-like; pecten means comb.',
  adductorlongus: 'ADDUCTOR-LONGUS is the long muscle bringing the thigh inward.',
  adductorbrevis: 'ADDUCTOR-BREVIS is the short adductor: brevis = short.',
  vastuslateralis: 'VASTUS-LATERALIS is the broad quadriceps muscle on the outer thigh.',
  vastusmedialis: 'VASTUS-MEDIALIS is the broad quadriceps muscle on the inner thigh.',
  vastusintermedius: 'VASTUS-INTERMEDIUS is the broad quadriceps muscle between the others.',
  fornix: 'FORNIX means arch or vault; it is a curved fibre bundle in the brain.',
  claustrum: 'CLAUSTRUM means enclosure; it is a thin deep-brain sheet.',
  insula: 'INSULA means island; the insular cortex is hidden inside the lateral sulcus.',
  arborvitae: 'ARBOR-VITAE means tree of life; the cerebellar white matter branches like a tree.',
  vermis: 'VERMIS means worm; the cerebellar vermis is the midline worm-like part.',
  flocculus: 'FLOCCULUS means little tuft; it is a small cerebellar lobe.',
  nodulus: 'NODULUS means little knot; it is part of the cerebellar vestibular region.',
  colliculus: 'COLLICULUS means little hill; the midbrain has superior and inferior colliculi.',
  tectum: 'TECTUM means roof; the midbrain tectum is its dorsal roof.',
  tegmentum: 'TEGMENTUM means covering; it is the ventral midbrain covering beneath the tectum.',
  epithalamus: 'EPI-THALAMUS is above the thalamus; epi = upon.',
  subthalamus: 'SUB-THALAMUS lies below the thalamus; sub = under.',
  pineal: 'PINEAL is pine-cone shaped; the pineal gland sits near the roof of the diencephalon.',
  habenula: 'HABENULA means little rein; it is a small epithalamic structure.',
  amygdaloid: 'AMYGDALOID is almond-shaped; amygdala comes from almond.',
  hypothalamic: 'HYPOTHALAMIC belongs to the region below the thalamus.',
  thalamic: 'THALAMIC belongs to the thalamus, a major relay region.',
  cortical: 'CORTICAL belongs to a cortex, the outer layer of an organ or brain region.',
  callosal: 'CALLOSAL belongs to the corpus callosum, the inter-hemisphere fibre bridge.',
  choroidal: 'CHOROIDAL belongs to the vascular choroid layer of the eye.',
  ependymal: 'EPENDYMAL belongs to the lining cells of the brain ventricles.',
  pectinate: 'PECTINATE means comb-like; pectinate muscles form ridges in atria.',
  coronary: 'CORONARY means crown-like; coronary vessels encircle the heart.',
  sinus: 'SINUS is a hollow or channel; the heart and skull each have named sinuses.',
  venule: 'VENULE is a small vein collecting blood from capillaries.',
  alveolar: 'ALVEOLAR belongs to the alveoli, the tiny air sacs.',
  bronchiole: 'BRONCHIOLE is a small airway branch beyond a bronchus.',
  bronchiolar: 'BRONCHIOLAR belongs to bronchioles.',
  rugae: 'RUGAE are folds or wrinkles; stomach rugae unfold as it fills.',
  villi: 'VILLI are tiny finger-like intestinal projections that increase absorption area.',
  microvilli: 'MICROVILLI are microscopic projections on absorptive cells.',
  crypts: 'CRYPTS are small pits or glands; intestinal crypts lie between villi.',
  plica: 'PLICA is a fold; plicae are folds of a membrane or joint lining.',
  greateromentum: 'GREATER-OMENTUM is the larger fatty apron over the abdominal organs.',
  lesseromentum: 'LESSER-OMENTUM is the smaller fold between liver and stomach/duodenum.',
  podocyte: 'PODOCYTE is a “foot cell” wrapping glomerular capillaries.',
  juxtaglomerular: 'JUXTA-GLOMERULAR lies beside the glomerulus and helps regulate kidney pressure.',
  glomerular: 'GLOMERULAR belongs to the glomerulus, the kidney filtration tuft.',
  proximalconvoluted: 'PROXIMAL-CONVOLUTED belongs to the first coiled nephron tubule.',
  distalconvoluted: 'DISTAL-CONVOLUTED belongs to the later coiled nephron tubule.',
  seminiferous: 'SEMINIFEROUS means seed-bearing; seminiferous tubules make sperm.',
  spermatogenic: 'SPERMATOGENIC means sperm-forming.',
  ejaculatory: 'EJACULATORY belongs to the ducts carrying semen toward the urethra.',
  fallopian: 'FALLOPIAN belongs to the uterine tube carrying the ovum.',
  uterine: 'UTERINE belongs to the uterus.',
  fimbrial: 'FIMBRIAL belongs to the fringe-like fimbriae of the uterine tube.',
  ovulatory: 'OVULATORY belongs to ovulation or release of an ovum.',
  cervical: 'CERVICAL belongs to the neck; in reproductive anatomy it often means the cervix.',
  vaginal: 'VAGINAL belongs to the vagina.',
  placenta: 'PLACENTA is the temporary organ exchanging oxygen, nutrients, and waste between mother and fetus.',
  amnion: 'AMNION is the inner fetal membrane around the embryo and amniotic fluid.',
  chorion: 'CHORION is the outer fetal membrane contributing to the placenta.',
  umbilical: 'UMBILICAL belongs to the cord connecting fetus and placenta.',
  endocardial: 'ENDOCARDIAL belongs to the inner lining of the heart.',
  myocardial: 'MYOCARDIAL belongs to the heart muscle.',
  intercostal: 'INTERCOSTAL lies between the ribs: inter = between, costal = rib.',
};

/* A second anatomy wave: these are deliberately complete notes rather than
   pronunciation-only entries. Each one is a difficult body-part name that
   benefits from a spoken form and a plain anatomical anchor. */
const ADVANCED_BODY_NOTES = {
  zygomatic: { say: 'zy-GO-mat-ik', plain: 'To do with the cheekbone or the cheek region.', from: 'Built out of: zygomat/o, cheekbone' },
  sphenoid: { say: 'SFEE-noyd', plain: 'The butterfly-shaped bone forming part of the floor of the skull.', from: 'Built out of: sphen/o, wedge' },
  ethmoid: { say: 'ETH-moyd', plain: 'A light bone between the eyes that contributes to the nasal cavity and skull base.', from: 'Built out of: ethmoid, sieve-like' },
  temporal: { say: 'TEM-puh-rul', plain: 'To do with the temporal bone at the side of the skull, near the ear.', from: 'Built out of: tempor/o, temple' },
  occipital: { say: 'ok-SIP-ih-tul', plain: 'To do with the occipital bone at the back and base of the skull.', from: 'Built out of: occipit/o, back of skull' },
  parietal: { say: 'puh-RY-uh-tul', plain: 'To do with one of the paired bones forming the upper sides and roof of the skull.', from: 'Built out of: pariet/o, wall' },
  frontal: { say: 'FRUN-tul', plain: 'To do with the forehead or the frontal bone at the front of the skull.', from: 'Built out of: front/o, forehead' },
  lacrimal: { say: 'LAK-rih-mul', plain: 'To do with tears or the small lacrimal bone near the inner eye.', from: 'Built out of: lacrim/o, tear' },
  vomer: { say: 'VOH-mer', plain: 'A thin bone forming much of the lower part of the nasal septum.', from: 'Built out of: vomer, ploughshare-shaped bone' },
  palatine: { say: 'PAL-ah-tyne', plain: 'To do with the palate; the palatine bones form the back part of the hard palate.', from: 'Built out of: palatin/o, palate' },
  hyoid: { say: 'HY-oyd', plain: 'A U-shaped neck bone that supports the tongue and larynx but does not directly join another bone.', from: 'Built out of: hyoid, U-shaped' },
  manubrium: { say: 'mah-NOO-bree-um', plain: 'The broad upper part of the sternum, where the clavicles and first ribs attach.', from: 'Built out of: manubr/i, handle' },
  xiphoid: { say: 'ZIF-oyd', plain: 'The small pointed lower part of the sternum.', from: 'Built out of: xiph/o, sword' },
  acetabulum: { say: 'ass-ET-ab-yoo-lum', plain: 'The cup-shaped socket in the pelvis that receives the head of the femur.', from: 'Built out of: acetabul/o, vinegar cup' },
  obturator: { say: 'ob-TOO-ray-ter', plain: 'A structure that closes or covers an opening; the obturator muscles act around the hip opening.', from: 'Built out of: obtur/o, close or stop' },
  ischium: { say: 'ISS-kee-um', plain: 'The strong lower-back part of the hip bone that bears weight when sitting.', from: 'Built out of: ischi/o, ischium' },
  ilium: { say: 'ILL-ee-um', plain: 'The broad upper part of each hip bone.', from: 'Built out of: ili/o, ilium' },
  pubis: { say: 'PYOO-biss', plain: 'The front part of each hip bone; the two sides meet at the pubic symphysis.', from: 'Built out of: pub/o, pubis' },
  ischial: { say: 'ISS-kee-ul', plain: 'To do with the ischium, especially its lower weight-bearing region.', from: 'Built out of: ischi/o, ischium' },
  pubic: { say: 'PYOO-bik', plain: 'To do with the pubis at the front of the pelvis.', from: 'Built out of: pub/o, pubis' },
  olecranon: { say: 'oh-LEK-rah-non', plain: 'The bony point of the ulna that forms the back of the elbow.', from: 'Built out of: olecran/o, elbow' },
  trochlea: { say: 'TROK-lee-ah', plain: 'A pulley-shaped joint surface, such as the humeral surface for the ulna.', from: 'Built out of: trochle/o, pulley' },
  capitulum: { say: 'kuh-PIT-yoo-lum', plain: 'A small rounded head, such as the humeral surface for the radius.', from: 'Built out of: capitul/o, little head' },
  styloid: { say: 'STY-loyd', plain: 'A slender, pointed projection from a bone, such as the radius or ulna.', from: 'Built out of: styl/o, pillar or pen' },
  scaphoid: { say: 'SKAF-oyd', plain: 'The boat-shaped wrist bone on the thumb side of the proximal carpal row.', from: 'Built out of: scaph/o, boat' },
  lunate: { say: 'LOO-nate', plain: 'The crescent-shaped wrist bone between the scaphoid and triquetrum.', from: 'Built out of: lun/o, moon' },
  triquetrum: { say: 'try-KWEE-trum', plain: 'The three-cornered wrist bone on the little-finger side of the proximal carpal row.', from: 'Built out of: triquetr/o, three-cornered' },
  pisiform: { say: 'PY-sih-form', plain: 'The pea-shaped wrist bone sitting on the front of the triquetrum.', from: 'Built out of: pisiform, pea-shaped' },
  trapezium: { say: 'tra-PEE-zee-um', plain: 'The wrist bone at the base of the thumb that meets the first metacarpal.', from: 'Built out of: trapezi/o, table-shaped' },
  trapezoid: { say: 'TRAP-eh-zoyd', plain: 'The small wrist bone between the trapezium and capitate, beneath the index finger.', from: 'Built out of: trapezi/o, table-shaped' },
  hamate: { say: 'HAM-ate', plain: 'The hook-bearing wrist bone on the little-finger side of the distal carpal row.', from: 'Built out of: hamat/o, hook' },
  navicular: { say: 'nav-IK-yoo-lar', plain: 'Boat-shaped; in the foot, the navicular lies between the talus and cuneiforms.', from: 'Built out of: navicul/o, little ship' },
  cuboid: { say: 'KYOO-boyd', plain: 'The cube-shaped lateral bone of the distal tarsal row.', from: 'Built out of: cub/o, cube' },
  cuneiform: { say: 'KYOO-nee-form', plain: 'Wedge-shaped; the three cuneiform bones sit in front of the navicular.', from: 'Built out of: cune/o, wedge' },
  rhomboid: { say: 'ROM-boyd', plain: 'A diamond-shaped muscle running from the spine to the medial border of the scapula.', from: 'Built out of: rhomb/o, diamond' },
  latissimus: { say: 'la-TISS-ih-muss', plain: 'The broad back muscle that pulls the upper limb down and back.', from: 'Built out of: latissim/o, broadest' },
  levator: { say: 'LEE-vay-tor', plain: 'A muscle whose main action is lifting a structure.', from: 'Built out of: levat/o, lift' },
  serratus: { say: 'seh-RAY-tus', plain: 'A saw-toothed muscle; serratus anterior lies along the ribs and moves the scapula.', from: 'Built out of: serrat/o, saw-toothed' },
  tensor: { say: 'TEN-sor', plain: 'A muscle that tightens or stretches a fascia or other structure.', from: 'Built out of: tens/o, stretch' },
  fascia: { say: 'FASH-ee-ah', plain: 'A sheet or band of connective tissue that wraps and separates muscles and other structures.', from: 'Built out of: fasci/o, band' },
  vastus: { say: 'VAS-tus', plain: 'Broad; used in the names of the large quadriceps muscles.', from: 'Built out of: vast/o, broad' },
  medialis: { say: 'mee-dee-AL-iss', plain: 'The medial one; a structure on the side nearer the body’s midline.', from: 'Built out of: medi/o, middle' },
  intermedius: { say: 'in-ter-MEE-dee-us', plain: 'The intermediate one, lying between two other structures.', from: 'Built out of: inter-, between + medi/o, middle' },
  medius: { say: 'MEE-dee-us', plain: 'The middle one; gluteus medius lies between gluteus maximus and minimus.', from: 'Built out of: medi/o, middle' },
  minimus: { say: 'MIN-ih-mus', plain: 'The smallest one; gluteus minimus lies deep to gluteus medius.', from: 'Built out of: minim/o, smallest' },
  digitorum: { say: 'dij-ih-TOR-um', plain: 'Of the fingers or toes; it appears in names of muscles acting on digits.', from: 'Built out of: digit/o, finger or toe' },
  epiglottis: { say: 'ep-ih-GLOT-iss', plain: 'A flap that folds over the laryngeal inlet during swallowing.', from: 'Built out of: epi-, upon + glott/o, voice' },
  glottis: { say: 'GLOT-iss', plain: 'The part of the larynx containing the vocal folds and the opening between them.', from: 'Built out of: glott/o, voice' },
  uvula: { say: 'YOO-vyoo-lah', plain: 'The small soft-tissue projection hanging from the back of the soft palate.', from: 'Built out of: uvul/o, grape-shaped projection' },
  tonsil: { say: 'TON-sil', plain: 'A small mass of lymphoid tissue guarding an entrance to the throat.', from: 'Built out of: tonsill/o, tonsil' },
  thymus: { say: 'THY-mus', plain: 'A lymphoid organ behind the sternum where T cells mature, especially in childhood.', from: 'Built out of: thym/o, thymus' },
  oropharynx: { say: 'or-oh-FAIR-inks', plain: 'The middle part of the throat behind the mouth.', from: 'Built out of: or/o, mouth + pharyng/o, throat' },
  interventricular: { say: 'in-ter-ven-TRIK-yoo-lar', plain: 'Between two ventricles; the interventricular septum separates the heart’s lower chambers.', from: 'Built out of: inter-, between + ventricul/o, ventricle' },
  interatrial: { say: 'in-ter-AY-tree-ul', plain: 'Between the two atria of the heart.', from: 'Built out of: inter-, between + atri/o, atrium' },
  sinoatrial: { say: 'sy-no-AY-tree-ul', plain: 'To do with the sinus node and atrium; the sinoatrial node starts the heartbeat.', from: 'Built out of: sinus + atri/o, atrium' },
  atrioventricular: { say: 'ay-tree-oh-ven-TRIK-yoo-lar', plain: 'Between an atrium and a ventricle; the atrioventricular node delays the signal.', from: 'Built out of: atri/o, atrium + ventricul/o, ventricle' },
  chordae: { say: 'KOR-dee', plain: 'Cord-like strands; chordae tendineae tether heart valves to papillary muscles.', from: 'Built out of: chord/o, cord' },
  papillary: { say: 'PAP-ih-lair-ee', plain: 'To do with a small nipple-shaped projection; papillary muscles anchor heart-valve cords.', from: 'Built out of: papill/o, nipple' },
  glomerulus: { say: 'gloh-MER-yoo-lus', plain: 'A tiny knot of capillaries where blood filtration begins in a nephron.', from: 'Built out of: glomerul/o, little ball' },
  nephron: { say: 'NEF-ron', plain: 'The kidney’s microscopic filtering and urine-forming unit.', from: 'Built out of: nephr/o, kidney' },
  calyx: { say: 'KAY-liks', plain: 'A cup-like space in the kidney that collects urine from a renal papilla.', from: 'Built out of: calyc/o, cup' },
  renal: { say: 'REE-nul', plain: 'To do with the kidney.', from: 'Built out of: ren/o, kidney' },
  mesocolon: { say: 'mez-oh-KOH-lon', plain: 'A fold of peritoneum that attaches part of the colon to the posterior abdominal wall.', from: 'Built out of: meso-, middle + colon' },
  mesorectum: { say: 'mez-oh-REK-tum', plain: 'The tissue and peritoneal fold surrounding and supporting the rectum.', from: 'Built out of: meso-, middle + rectum' },
  acromion: { say: 'a-KROH-mee-on', plain: 'The highest outer projection of the scapula, forming the shoulder roof.', from: 'Built out of: acromi/o, shoulder tip' },
  coracoid: { say: 'KOR-a-koyd', plain: 'A beak-shaped projection from the scapula.', from: 'Built out of: corac/o, crow' },
  trochanter: { say: 'tro-KAN-ter', plain: 'A large projection of the femur where hip muscles attach.', from: 'Built out of: trochanter, turning point' },
  tuberosity: { say: 'too-ber-OSS-ih-tee', plain: 'A large rough projection on a bone for tendon or muscle attachment.', from: 'Built out of: tuber/o, swelling or lump' },
  epicondyle: { say: 'ep-ih-KON-dyle', plain: 'A projection above a condyle, usually serving as an attachment site.', from: 'Built out of: epi-, above + condyl/o, knuckle' },
  foramen: { say: 'fo-RAY-men', plain: 'A hole or opening through bone for a nerve or vessel.', from: 'Built out of: foramin/o, opening' },
  fossa: { say: 'FOSS-ah', plain: 'A shallow hollow or depression.', from: 'Built out of: foss/o, hollow' },
  sulcus: { say: 'SUL-kus', plain: 'A groove or furrow; in the brain, a groove between gyri.', from: 'Built out of: sulc/o, groove' },
  gyrus: { say: 'JY-rus', plain: 'A ridge or raised fold on the surface of the brain.', from: 'Built out of: gyr/o, turning or winding' },
  meatus: { say: 'mee-AY-tus', plain: 'A canal or passage, such as the external acoustic meatus.', from: 'Built out of: meat/o, passage' },
  hilum: { say: 'HY-lum', plain: 'An organ’s entry and exit point for vessels, nerves, or ducts.', from: 'Built out of: hil/o, gateway' },
  lamina: { say: 'LAM-ih-nah', plain: 'A thin plate; a vertebral lamina helps form the roof of the spinal canal.', from: 'Built out of: lamin/o, plate' },
  pedicle: { say: 'PED-ih-kul', plain: 'A short stalk or bridge connecting one anatomical part to another.', from: 'Built out of: pedicul/o, little foot or stalk' },
  ramus: { say: 'RAY-mus', plain: 'A branch-like part of a structure, such as the mandibular ramus.', from: 'Built out of: ram/o, branch' },
  aponeurosis: { say: 'ap-oh-noo-ROH-sis', plain: 'A broad, flat sheet of tendon.', from: 'Built out of: apo-, away + neur/o, tendon' },
  periosteum: { say: 'per-ee-OSS-tee-um', plain: 'The tough connective-tissue covering on the outer surface of bone.', from: 'Built out of: peri-, around + oste/o, bone' },
  symphysis: { say: 'SIM-fih-sis', plain: 'A midline joint in which the two sides are joined by fibrocartilage.', from: 'Built out of: sym-, together + phys/o, growing' },
  costochondral: { say: 'kos-to-KON-drul', plain: 'Relating to a rib and its costal cartilage.', from: 'Built out of: cost/o, rib + chondr/o, cartilage' },
  sacrococcygeal: { say: 'SAY-kroh-kok-SIJ-ee-ul', plain: 'Relating to the sacrum and coccyx together.', from: 'Built out of: sacr/o, sacrum + coccyg/o, tailbone' },
  lumbosacral: { say: 'lum-bo-SAY-krul', plain: 'Relating to the lumbar region and sacrum together.', from: 'Built out of: lumb/o, lower back + sacr/o, sacrum' },
  iliacus: { say: 'ih-LY-ah-kus', plain: 'A muscle in the iliac fossa that helps flex the hip.', from: 'Built out of: iliac/o, ilium' },
  psoas: { say: 'SOH-as', plain: 'A deep muscle that helps flex the hip and connects the lumbar region to the femur.', from: 'Built out of: psoas, loin muscle' },
  rectus: { say: 'REK-tus', plain: 'Straight; used for muscles that run relatively straight.', from: 'Built out of: rect/o, straight' },
  abdominis: { say: 'ab-DOM-ih-niss', plain: 'Of the abdomen; used in names of abdominal muscles.', from: 'Built out of: abdomin/o, abdomen' },
  transversus: { say: 'trans-VER-sus', plain: 'Running across or transverse; used for muscles crossing the body.', from: 'Built out of: trans-, across + vers/o, turn' },
  oblique: { say: 'oh-BLEEK', plain: 'Slanting or running at an angle.', from: 'Built out of: obliqu/o, slanting' },
  multifidus: { say: 'mul-TIF-ih-dus', plain: 'A deep back muscle made of many short, divided fascicles.', from: 'Built out of: multi-, many + fid/o, split' },
  splenius: { say: 'SPLEE-nee-us', plain: 'A band-like muscle of the back of the neck.', from: 'Built out of: splen/o, bandage' },
  scalene: { say: 'SKAY-leen', plain: 'One of the sloping neck muscles that form the scalene group.', from: 'Built out of: scalen/o, uneven or sloping' },
  digastric: { say: 'dy-GAS-trik', plain: 'A muscle with two bellies joined by an intermediate tendon.', from: 'Built out of: di-, two + gastr/o, belly' },
  stylohyoid: { say: 'STY-lo-HY-oyd', plain: 'A muscle running from the styloid process to the hyoid bone.', from: 'Built out of: styl/o, pillar + hyoid' },
  genioglossus: { say: 'JEE-nee-oh-GLOSS-us', plain: 'A muscle running from the chin region to the tongue.', from: 'Built out of: geni/o, chin + gloss/o, tongue' },
  hyoglossus: { say: 'HY-oh-GLOSS-us', plain: 'A muscle running from the hyoid bone to the tongue.', from: 'Built out of: hyoid + gloss/o, tongue' },
  masseter: { say: 'MAS-ih-ter', plain: 'A major muscle of chewing at the side of the jaw.', from: 'Built out of: masseter, chewer' },
  carina: { say: 'kah-RY-nah', plain: 'A keel-like ridge at the point where the trachea divides into main bronchi.', from: 'Built out of: carin/o, keel' },
  epicardium: { say: 'ep-ih-KAR-dee-um', plain: 'The outer layer of the heart wall.', from: 'Built out of: epi-, upon + cardi/o, heart' },
  pericardial: { say: 'per-ih-KAR-dee-ul', plain: 'To do with the sac or tissues around the heart.', from: 'Built out of: peri-, around + cardi/o, heart' },
  pleural: { say: 'PLOOR-ul', plain: 'To do with the pleura or the membranes around the lungs.', from: 'Built out of: pleur/o, side or rib' },
  bronchopulmonary: { say: 'bron-koh-PUL-muh-nair-ee', plain: 'Relating to the bronchi and lungs together.', from: 'Built out of: bronch/o, bronchus + pulmon/o, lung' },
  tracheobronchial: { say: 'TRAY-kee-oh-BRON-kee-ul', plain: 'Relating to the trachea and bronchi together.', from: 'Built out of: trache/o, trachea + bronch/o, bronchus' },
  telencephalon: { say: 'tel-en-SEF-ah-lon', plain: 'The endbrain, including the cerebral hemispheres.', from: 'Built out of: tel-, end + encephal/o, brain' },
  mesencephalon: { say: 'mes-en-SEF-ah-lon', plain: 'The midbrain division of the developing brain.', from: 'Built out of: mes-, middle + encephal/o, brain' },
  metencephalon: { say: 'met-en-SEF-ah-lon', plain: 'The developing brain division that gives rise to the pons and cerebellum.', from: 'Built out of: met-, after + encephal/o, brain' },
  myelencephalon: { say: 'my-el-en-SEF-ah-lon', plain: 'The developing brain division that gives rise to the medulla.', from: 'Built out of: myel/o, marrow or medulla + encephal/o, brain' },
  prosencephalon: { say: 'pros-en-SEF-ah-lon', plain: 'The forebrain division of the developing brain.', from: 'Built out of: pros-, before or forward + encephal/o, brain' },
  rhombencephalon: { say: 'rom-ben-SEF-ah-lon', plain: 'The hindbrain division of the developing brain.', from: 'Built out of: rhomb/o, diamond + encephal/o, brain' },
  meninges: { say: 'meh-NIN-jeez', plain: 'The three protective membranes around the brain and spinal cord.', from: 'Built out of: mening/o, membrane' },
  dura: { say: 'DOO-rah', plain: 'The tough outer layer of the meninges.', from: 'Built out of: dur/o, hard' },
  pia: { say: 'PEE-ah', plain: 'The delicate inner meningeal layer closely covering nervous tissue.', from: 'Built out of: pia, tender or delicate' },
  chiasm: { say: 'KY-az-um', plain: 'A crossing of nerve fibres, such as at the optic chiasm.', from: 'Built out of: chiasm/o, crossing' },
  decussation: { say: 'dee-kus-SAY-shun', plain: 'A crossing of nerve fibres from one side to the other.', from: 'Built out of: decuss/o, cross' },
  fasciculus: { say: 'fah-SIK-yoo-lus', plain: 'A small bundle of nerve fibres.', from: 'Built out of: fascicul/o, small bundle' },
  peduncle: { say: 'peh-DUN-kul', plain: 'A stalk-like bundle connecting one brain region with another.', from: 'Built out of: peduncul/o, little foot or stalk' },
  corticospinal: { say: 'KOR-tih-koh-SPY-nul', plain: 'Running from the cerebral cortex to the spinal cord.', from: 'Built out of: cortic/o, cortex + spin/o, spine' },
  spinothalamic: { say: 'SPY-no-thah-LAM-ik', plain: 'Running from the spinal cord toward the thalamus.', from: 'Built out of: spin/o, spine + thalam/o, thalamus' },
  macula: { say: 'MAK-yoo-lah', plain: 'A specialised spot or patch; in the retina it supports sharp central vision.', from: 'Built out of: macul/o, spot' },
  utricle: { say: 'YOO-trih-kul', plain: 'A small vestibular sac sensing head tilt and horizontal linear motion.', from: 'Built out of: utricul/o, little sac' },
  saccule: { say: 'SAK-yool', plain: 'A small vestibular sac sensing vertical linear motion.', from: 'Built out of: saccul/o, little sac' },
  pylorus: { say: 'py-LOR-us', plain: 'The outlet of the stomach leading into the duodenum.', from: 'Built out of: pylor/o, gatekeeper' },
  gallbladder: { say: 'GAWL-blad-er', plain: 'A small sac under the liver that stores and concentrates bile.', from: 'Built out of: gall/o, bile + bladder' },
  detrusor: { say: 'dee-TROO-sor', plain: 'The smooth muscle layer of the urinary bladder.', from: 'Built out of: detrus/o, drive down or expel' },
  epididymis: { say: 'ep-ih-DID-ih-miss', plain: 'A long coiled tube on the testis where sperm mature and are stored.', from: 'Built out of: epididym/o, upon the testis' },
  fimbriae: { say: 'FIM-bree-ee', plain: 'Fringe-like projections at the end of a uterine tube near an ovary.', from: 'Built out of: fim bri/o, fringe' },
  endometrium: { say: 'en-doh-MEE-tree-um', plain: 'The inner lining of the uterus.', from: 'Built out of: endo-, within + metri/o, uterus' },
  myometrium: { say: 'my-oh-MEE-tree-um', plain: 'The muscular layer of the uterus.', from: 'Built out of: my/o, muscle + metri/o, uterus' },
  cervix: { say: 'SER-viks', plain: 'The neck-like lower part of the uterus opening into the vagina.', from: 'Built out of: cervic/o, neck' },
  prostate: { say: 'PROS-tate', plain: 'A gland below the bladder surrounding the first part of the urethra.', from: 'Built out of: prostat/o, standing before' },
  perineum: { say: 'per-ih-NEE-um', plain: 'The region forming the pelvic floor between the external genitalia and anus.', from: 'Built out of: perine/o, pelvic floor region' },
  sella: { say: 'SELL-ah', plain: 'A saddle-shaped hollow in the sphenoid bone.', from: 'Built out of: sell/o, saddle' },
  turcica: { say: 'TUR-sih-kah', plain: 'Turkish-saddle shaped; sella turcica cradles the pituitary gland.', from: 'Built out of: turc/o, Turkish' },
  crista: { say: 'KRIS-tah', plain: 'A crest or ridge, such as crista galli in the skull.', from: 'Built out of: crist/o, crest' },
  mastoid: { say: 'MAS-toyd', plain: 'To do with the breast-shaped process behind the ear.', from: 'Built out of: mast/o, breast' },
  nuchal: { say: 'NOO-kul', plain: 'To do with the nape or back of the neck.', from: 'Built out of: nuch/o, neck' },
  odontoid: { say: 'oh-DON-toyd', plain: 'Tooth-like; the odontoid process is the dens of the axis.', from: 'Built out of: odont/o, tooth' },
  dens: { say: 'DENZ', plain: 'The tooth-shaped projection of C2 that acts as a pivot for C1.', from: 'Built out of: dent/o, tooth' },
  atlas: { say: 'AT-lus', plain: 'The first cervical vertebra, supporting the skull.', from: 'Built out of: atlas, bearer' },
  axis: { say: 'AK-siss', plain: 'The second cervical vertebra, providing the pivot for head rotation.', from: 'Built out of: axis, pivot' },
  corpus: { say: 'KOR-pus', plain: 'Body; used in anatomical names for a body-like main part.', from: 'Built out of: corpor/o, body' },
  callosum: { say: 'kah-LOH-sum', plain: 'Tough or hard; corpus callosum is the fibre bridge between brain hemispheres.', from: 'Built out of: callos/o, hard' },
  choroid: { say: 'KOR-oyd', plain: 'The vascular layer of the eye between the retina and sclera.', from: 'Built out of: chori/o, membrane or skin' },
  hypophysis: { say: 'hy-POF-ih-sis', plain: 'Another name for the pituitary gland, hanging below the brain.', from: 'Built out of: hypo-, below + phys/o, growth' },
  adenohypophysis: { say: 'ad-en-oh-hy-POF-ih-sis', plain: 'The glandular front part of the pituitary gland.', from: 'Built out of: adeno-, gland + hypo-, below + phys/o, growth' },
  neurohypophysis: { say: 'noo-roh-hy-POF-ih-sis', plain: 'The neural back part of the pituitary gland.', from: 'Built out of: neur/o, nerve + hypo-, below + phys/o, growth' },
  diencephalon: { say: 'dy-en-SEF-ah-lon', plain: 'The brain region containing the thalamus and hypothalamus.', from: 'Built out of: di-, between + encephal/o, brain' },
  medulla: { say: 'meh-DUL-ah', plain: 'An inner core; the medulla oblongata is the lower brainstem region.', from: 'Built out of: medull/o, inner core or marrow' },
  oblongata: { say: 'ob-long-GAH-tah', plain: 'Elongated; medulla oblongata is the elongated lower brainstem.', from: 'Built out of: oblong/o, elongated' },
  ventricle: { say: 'VEN-trih-kul', plain: 'A small cavity; brain ventricles contain cerebrospinal fluid.', from: 'Built out of: ventricul/o, little cavity' },
  cerebral: { say: 'seh-REE-brul', plain: 'To do with the cerebrum, the large thinking part of the brain.', from: 'Built out of: cerebr/o, cerebrum' },
  cerebellar: { say: 'ser-eh-BEL-ar', plain: 'To do with the cerebellum, which coordinates movement and balance.', from: 'Built out of: cerebell/o, little brain' },
  arachnoid: { say: 'ah-RAK-noyd', plain: 'The spider-web-like middle layer of the meninges.', from: 'Built out of: arachn/o, spider' },
  meningeal: { say: 'meh-NIN-jee-ul', plain: 'To do with the meninges around the brain and spinal cord.', from: 'Built out of: mening/o, membrane' },
  subarachnoid: { say: 'sub-ah-RAK-noyd', plain: 'Beneath the arachnoid layer; cerebrospinal fluid occupies this space.', from: 'Built out of: sub-, under + arachn/o, spider' },
  trochlear: { say: 'TROK-lee-ar', plain: 'To do with the fourth cranial nerve, which moves an eye muscle.', from: 'Built out of: trochle/o, pulley' },
  trigeminal: { say: 'try-JEM-in-ul', plain: 'To do with the fifth cranial nerve, with three major divisions.', from: 'Built out of: tri-, three + gemin/o, twin' },
  accessory: { say: 'ak-SES-or-ee', plain: 'To do with the eleventh cranial nerve, assisting head and shoulder movement.', from: 'Built out of: access/o, approach or join' },
  subclavius: { say: 'sub-KLAY-vee-us', plain: 'A small muscle lying beneath the clavicle.', from: 'Built out of: sub-, under + clavicul/o, collarbone' },
  rotatores: { say: 'roh-tah-TOR-eez', plain: 'Small deep back muscles that rotate the vertebral column.', from: 'Built out of: rotat/o, turn' },
  semispinalis: { say: 'SEM-ee-spy-NAH-liss', plain: 'A deep back muscle running partly along the spine.', from: 'Built out of: semi-, half + spin/o, spine' },
  longissimus: { say: 'lon-JIS-ih-mus', plain: 'The longest column of the erector spinae muscle group.', from: 'Built out of: longissim/o, longest' },
  iliocostalis: { say: 'il-ee-oh-kos-TAL-iss', plain: 'A back muscle running from the ilium toward the ribs.', from: 'Built out of: ili/o, ilium + cost/o, rib' },
  transversospinalis: { say: 'trans-VER-so-spy-NAH-liss', plain: 'A deep back muscle group running from transverse processes toward the spine.', from: 'Built out of: transvers/o, across + spin/o, spine' },
  erector: { say: 'ih-REK-tor', plain: 'A muscle that raises or extends; erector spinae extends the spine.', from: 'Built out of: erect/o, raise or straighten' },
  spinae: { say: 'SPY-nee', plain: 'Of the spine; erector spinae is the spine-extending group.', from: 'Built out of: spin/o, spine' },
  infundibulum: { say: 'in-fun-DIB-yoo-lum', plain: 'A funnel-shaped passage or structure.', from: 'Built out of: infundibul/o, funnel' },
  ampulla: { say: 'am-PUL-ah', plain: 'A widened flask-like section of a tube.', from: 'Built out of: ampull/o, flask' },
  isthmus: { say: 'ISS-mus', plain: 'A narrow bridge joining two wider regions.', from: 'Built out of: isthm/o, narrow passage' },
  trigone: { say: 'TRY-gohn', plain: 'A triangular area; the bladder trigone lies between three openings.', from: 'Built out of: trigon/o, triangle' },
  ileocecal: { say: 'IL-ee-oh-SEE-kul', plain: 'To do with the junction between the ileum and caecum.', from: 'Built out of: ile/o, ileum + caec/o, caecum' },
  hepatopancreatic: { say: 'hep-at-oh-pan-kree-AT-ik', plain: 'To do with the liver and pancreas together.', from: 'Built out of: hepat/o, liver + pancreat/o, pancreas' },
  sphincter: { say: 'SFINK-ter', plain: 'A ring muscle that closes an opening.', from: 'Built out of: sphincter, binder' },
  papilla: { say: 'pah-PIL-ah', plain: 'A small nipple-like projection, such as a renal papilla.', from: 'Built out of: papill/o, nipple' },
  duodenal: { say: 'doo-oh-DEE-nul', plain: 'To do with the duodenum, the first small-intestine segment.', from: 'Built out of: duoden/o, duodenum' },
  sclera: { say: 'SKLEER-ah', plain: 'The tough white outer coat of the eye.', from: 'Built out of: scler/o, hard' },
  tympanum: { say: 'TIM-pah-num', plain: 'The eardrum, which vibrates with sound.', from: 'Built out of: tympan/o, drum' },
  malleus: { say: 'MAL-ee-us', plain: 'The hammer-shaped first ossicle of the middle ear.', from: 'Built out of: malle/o, hammer' },
  incus: { say: 'IN-kus', plain: 'The anvil-shaped middle ossicle of the ear.', from: 'Built out of: incud/o, anvil' },
  stapes: { say: 'STAY-peez', plain: 'The stirrup-shaped final ossicle, transmitting sound to the inner ear.', from: 'Built out of: stapedi/o, stirrup' },
  ossicles: { say: 'OSS-ih-kulz', plain: 'The three tiny middle-ear bones: malleus, incus, and stapes.', from: 'Built out of: ossicul/o, little bone' },
  vestibule: { say: 'VES-tib-yool', plain: 'An entrance hall; the inner-ear vestibule links the cochlea and semicircular canals.', from: 'Built out of: vestibul/o, entrance' },
  bregma: { say: 'BREG-mah', plain: 'The meeting point of the coronal and sagittal sutures near the front roof of the skull.', from: 'Built out of: bregmat/o, front of skull' },
  lambda: { say: 'LAM-dah', plain: 'The meeting point of the sagittal and lambdoid sutures near the back of the skull.', from: 'Built out of: lambd/o, lambda-shaped' },
  pterion: { say: 'TEER-ee-on', plain: 'The wing-shaped junction of skull bones on the side of the head.', from: 'Built out of: pteri/o, wing' },
  asterion: { say: 'as-TEER-ee-on', plain: 'The star-shaped junction of skull bones behind the ear.', from: 'Built out of: aster/o, star' },
  squamous: { say: 'SKWAY-mus', plain: 'Flat and scale-like; used for the thin squamous part of the temporal bone.', from: 'Built out of: squam/o, scale' },
  nasal: { say: 'NAY-zul', plain: 'To do with the nose or nasal cavity.', from: 'Built out of: nas/o, nose' },
  maxillary: { say: 'MAK-sih-lair-ee', plain: 'To do with the maxilla, the upper jaw bone.', from: 'Built out of: maxill/o, upper jaw' },
  mandibular: { say: 'MAN-dib-yoo-lar', plain: 'To do with the mandible, the lower jaw bone.', from: 'Built out of: mandibul/o, lower jaw' },
  endosteum: { say: 'en-DOS-tee-um', plain: 'The membrane lining the inner surfaces of bone.', from: 'Built out of: endo-, within + oste/o, bone' },
  osteon: { say: 'OS-tee-on', plain: 'The basic cylindrical structural unit of compact bone.', from: 'Built out of: oste/o, bone' },
  lamellae: { say: 'lah-MEL-eye', plain: 'Thin layers of bone arranged around an osteon.', from: 'Built out of: lamell/o, thin plate' },
  lacunae: { say: 'lah-KYOO-nee', plain: 'Small spaces in bone matrix where osteocytes live.', from: 'Built out of: lacun/o, hollow or gap' },
  canaliculi: { say: 'kan-ah-LIK-yoo-lye', plain: 'Tiny channels linking bone lacunae.', from: 'Built out of: canalicul/o, little canal' },
  osteocyte: { say: 'OS-tee-oh-site', plain: 'A mature bone cell housed in a lacuna.', from: 'Built out of: oste/o, bone + -cyte, cell' },
  supraorbital: { say: 'soo-prah-OR-bih-tul', plain: 'Above the orbit or eye socket.', from: 'Built out of: supra-, above + orbit/o, eye socket' },
  infraorbital: { say: 'in-frah-OR-bih-tul', plain: 'Below the orbit or eye socket.', from: 'Built out of: infra-, below + orbit/o, eye socket' },
  mental: { say: 'MEN-tul', plain: 'To do with the chin; the mental foramen is in the mandible.', from: 'Built out of: ment/o, chin' },
  jugular: { say: 'JOO-gyoo-lar', plain: 'To do with the neck; jugular veins drain blood from the head.', from: 'Built out of: jugul/o, throat or neck' },
  carotid: { say: 'kah-ROT-id', plain: 'To do with the arteries supplying the neck and brain.', from: 'Built out of: carotid/o, sleep or stupor' },
  magnum: { say: 'MAG-num', plain: 'Large; foramen magnum is the large opening in the skull base.', from: 'Built out of: magn/o, large' },
  stylomastoid: { say: 'STY-loh-MAS-toyd', plain: 'Between or relating to the styloid and mastoid processes.', from: 'Built out of: styl/o, pillar + mast/o, breast' },
  spinosum: { say: 'spy-NOH-sum', plain: 'Spine-like; foramen spinosum is a small opening in the skull.', from: 'Built out of: spin/o, spine' },
  ovale: { say: 'oh-VAH-lee', plain: 'Oval; foramen ovale is an oval opening in the skull.', from: 'Built out of: oval/o, egg-shaped' },
  rotundum: { say: 'roh-TUN-dum', plain: 'Round; foramen rotundum is a round opening in the skull.', from: 'Built out of: rotund/o, round' },
  lacerum: { say: 'LAS-er-um', plain: 'Torn or ragged; foramen lacerum is an irregular skull opening.', from: 'Built out of: lacer/o, torn' },
  orbital: { say: 'OR-bih-tul', plain: 'To do with the orbit, the bony eye socket.', from: 'Built out of: orbit/o, eye socket' },
  piriformis: { say: 'pir-ih-FOR-miss', plain: 'A pear-shaped muscle passing through the deep gluteal region.', from: 'Built out of: piriform, pear-shaped' },
  gemellus: { say: 'jeh-MEL-us', plain: 'A small paired hip muscle; gemellus means little twin.', from: 'Built out of: gemell/o, twin' },
  quadratusfemoris: { say: 'kwod-RAY-tus FEM-or-iss', plain: 'A square muscle running in the deep gluteal region near the femur.', from: 'Built out of: quadrat/o, square + femor/o, thigh' },
  obturatorinternus: { say: 'ob-TOO-ray-ter in-TER-nus', plain: 'The internal obturator muscle lining the inside of the obturator region.', from: 'Built out of: obtur/o, close + intern/o, inside' },
  obturatorexternus: { say: 'ob-TOO-ray-ter ex-TER-nus', plain: 'The external obturator muscle on the outside of the obturator region.', from: 'Built out of: obtur/o, close + extern/o, outside' },
  iliotibial: { say: 'IL-ee-oh-TIB-ee-ul', plain: 'To do with the ilium and tibia; the iliotibial tract runs along the lateral thigh.', from: 'Built out of: ili/o, ilium + tibi/o, tibia' },
  interossei: { say: 'in-ter-OSS-ee-eye', plain: 'Muscles lying between bones, especially in the hand or foot.', from: 'Built out of: inter-, between + osse/o, bone' },
  lumbricals: { say: 'LUM-brih-kulz', plain: 'Small worm-like muscles of the hand or foot.', from: 'Built out of: lumbric/o, earthworm' },
  thenar: { say: 'THEE-nar', plain: 'The fleshy mound at the base of the thumb.', from: 'Built out of: thenar, palm of hand' },
  hypothenar: { say: 'hy-PO-thee-nar', plain: 'The fleshy mound at the base of the little finger.', from: 'Built out of: hypo-, under + thenar, palm' },
  opponens: { say: 'oh-POH-nenz', plain: 'A muscle that brings the thumb into opposition with the fingers.', from: 'Built out of: oppon/o, oppose' },
  abductorpollicis: { say: 'ab-DUK-tor POL-ih-siss', plain: 'A muscle that moves the thumb away from the hand.', from: 'Built out of: ab-, away + duct/o, lead + pollic/o, thumb' },
  flexorcarpi: { say: 'FLEK-sor KAR-pye', plain: 'A muscle that flexes the wrist.', from: 'Built out of: flex/o, bend + carp/o, wrist' },
  extensorcarpi: { say: 'ek-STEN-sor KAR-pye', plain: 'A muscle that extends the wrist.', from: 'Built out of: extens/o, stretch out + carp/o, wrist' },
  metacarpophalangeal: { say: 'met-ah-KAR-poh-fah-LAN-jee-ul', plain: 'Relating to the joints between metacarpals and finger phalanges.', from: 'Built out of: metacarp/o, hand bone + phalang/o, finger bone' },
  interphalangeal: { say: 'in-ter-fah-LAN-jee-ul', plain: 'Relating to a joint between two phalanges.', from: 'Built out of: inter-, between + phalang/o, finger or toe bone' },
  talocalcaneal: { say: 'TAY-loh-kal-KAY-nee-ul', plain: 'Relating to the joint between the talus and calcaneus.', from: 'Built out of: tal/o, talus + calcane/o, heel bone' },
  calcaneocuboid: { say: 'kal-KAY-nee-oh-KYOO-boyd', plain: 'Relating to the joint between the calcaneus and cuboid.', from: 'Built out of: calcane/o, heel bone + cub/o, cube' },
  tarsometatarsal: { say: 'tar-soh-met-ah-TAR-sul', plain: 'Relating to a joint between a tarsal and a metatarsal.', from: 'Built out of: tars/o, ankle bone + metatars/o, foot bone' },
  intertarsal: { say: 'in-ter-TAR-sul', plain: 'Relating to a joint between tarsal bones.', from: 'Built out of: inter-, between + tars/o, ankle bone' },
  radiocarpal: { say: 'RAY-dee-oh-KAR-pul', plain: 'Relating to the joint between the radius and wrist.', from: 'Built out of: radi/o, radius + carp/o, wrist' },
  septum: { say: 'SEP-tum', plain: 'A partition separating two spaces.', from: 'Built out of: sept/o, partition' },
  auricle: { say: 'AW-rih-kul', plain: 'A small ear-shaped structure; it can mean the external ear or an atrial appendage.', from: 'Built out of: auricul/o, ear' },
  trabeculae: { say: 'trah-BEK-yoo-lee', plain: 'Small beams or struts, especially the lattice of spongy bone.', from: 'Built out of: trabecul/o, little beam' },
  carneae: { say: 'KAR-nee-ee', plain: 'Fleshy; trabeculae carneae are muscular ridges inside the ventricles.', from: 'Built out of: carn/o, flesh' },
  aortic: { say: 'ay-OR-tik', plain: 'To do with the aorta.', from: 'Built out of: aort/o, aorta' },
  mitral: { say: 'MY-trul', plain: 'To do with the two-cusped left atrioventricular valve.', from: 'Built out of: mitr/o, mitre or bishop’s hat' },
  tricuspid: { say: 'try-KUS-pid', plain: 'Having three cusps; the tricuspid valve is on the right side of the heart.', from: 'Built out of: tri-, three + cusp/o, point' },
  substantia: { say: 'sub-STAN-shee-ah', plain: 'Substance; used in names of distinct brain regions.', from: 'Built out of: substant/o, substance' },
  nigra: { say: 'NYE-grah', plain: 'Black; substantia nigra is a darkly pigmented brain region.', from: 'Built out of: nigr/o, black' },
  caudate: { say: 'KAW-date', plain: 'Tail-like; the caudate nucleus has a curved tail.', from: 'Built out of: caud/o, tail' },
  putamen: { say: 'pyoo-TAY-men', plain: 'A shell-like deep brain nucleus.', from: 'Built out of: putamen, shell or husk' },
  aqueduct: { say: 'AK-wih-dukt', plain: 'A channel carrying water or fluid; the cerebral aqueduct carries CSF.', from: 'Built out of: aque/o, water + duct/o, lead' },
  bulb: { say: 'BULB', plain: 'A rounded swelling; the olfactory bulb receives smell information.', from: 'Built out of: bulb/o, swelling' },
  tract: { say: 'TRAKT', plain: 'A bundle or pathway, especially a bundle of nerve fibres.', from: 'Built out of: tract/o, pull or pathway' },
  bowman: { say: 'BOH-man', plain: 'Relating to the capsule surrounding a kidney glomerulus.', from: 'Built out of: Bowman, eponym for the capsule' },
  collecting: { say: 'keh-LEK-ting', plain: 'Gathering; collecting ducts gather urine from several nephrons.', from: 'Built out of: collect/o, gather' },
  duct: { say: 'DUKT', plain: 'A tube carrying fluid or a secretion.', from: 'Built out of: duct/o, lead' },
  seminal: { say: 'SEM-ih-nul', plain: 'To do with semen or seed.', from: 'Built out of: semin/o, seed' },
  vesicle: { say: 'VES-ih-kul', plain: 'A small sac or bubble-like compartment.', from: 'Built out of: vesicul/o, small sac' },
  vas: { say: 'VAS', plain: 'A vessel or duct; vas deferens carries sperm away from the epididymis.', from: 'Built out of: vas/o, vessel' },
  deferens: { say: 'DEF-er-enz', plain: 'Carrying away; the vas deferens carries sperm toward the ejaculatory duct.', from: 'Built out of: defer/o, carry away' },
  ovary: { say: 'OH-vuh-ree', plain: 'The female gonad that stores and releases oocytes.', from: 'Built out of: ovar/o, ovary' },
  oviduct: { say: 'OH-vih-dukt', plain: 'A tube carrying an ovum; in humans it is the uterine tube.', from: 'Built out of: ovi/o, egg + duct/o, lead' },
  omentum: { say: 'oh-MEN-tum', plain: 'An apron-like fold of peritoneum over the abdominal organs.', from: 'Built out of: oment/o, apron or covering' },
  pancreatic: { say: 'pan-kree-AT-ik', plain: 'To do with the pancreas.', from: 'Built out of: pancreat/o, pancreas' },
  anal: { say: 'AY-nul', plain: 'To do with the anus, the terminal digestive opening.', from: 'Built out of: an/o, anus' },
  canal: { say: 'kuh-NAL', plain: 'A passage or tunnel through a body structure.', from: 'Built out of: canal/o, canal' },
  cricoid: { say: 'KRY-koyd', plain: 'Ring-shaped; the cricoid cartilage forms the lower laryngeal ring.', from: 'Built out of: cric/o, ring' },
  arytenoid: { say: 'ar-ih-TEE-noyd', plain: 'A paired laryngeal cartilage that anchors a vocal fold.', from: 'Built out of: aryten/o, ladle or pitcher' },
  vocal: { say: 'VOH-kul', plain: 'To do with voice or the vocal folds of the larynx.', from: 'Built out of: voc/o, voice' },
  folds: { say: 'FOHLDZ', plain: 'Ridges of tissue; the vocal folds vibrate to make sound.', from: 'Built out of: fold, bend or crease' },
  laryngeal: { say: 'luh-RIN-jee-ul', plain: 'To do with the larynx or voice box.', from: 'Built out of: laryng/o, larynx' },
  bronchial: { say: 'BRON-kee-ul', plain: 'To do with the bronchi, the main airway branches.', from: 'Built out of: bronch/o, bronchus' },
  lymph: { say: 'LIMF', plain: 'Clear fluid carried through lymphatic vessels and nodes.', from: 'Built out of: lymph/o, lymph' },
  node: { say: 'NOHD', plain: 'A small knot; a lymph node filters lymph and supports immune defence.', from: 'Built out of: nod/o, knot' },
  thymic: { say: 'THY-mik', plain: 'To do with the thymus.', from: 'Built out of: thym/o, thymus' },
  urethral: { say: 'yoo-REE-thrul', plain: 'To do with the urethra, the tube carrying urine out of the body.', from: 'Built out of: urethr/o, urethra' },
  renalpelvis: { say: 'REE-nul PEL-viss', plain: 'The funnel-like urine-collecting space inside the kidney.', from: 'Built out of: ren/o, kidney + pelv/i, basin' },
  tympanic: { say: 'tim-PAN-ik', plain: 'To do with the eardrum or middle-ear cavity.', from: 'Built out of: tympan/o, drum' },
  auditory: { say: 'AW-dih-tor-ee', plain: 'To do with hearing or the ear.', from: 'Built out of: audit/o, hearing' },
  olfactory: { say: 'ol-FAK-tor-ee', plain: 'To do with smell or the olfactory pathway.', from: 'Built out of: olfact/o, smell' },
  optic: { say: 'OP-tik', plain: 'To do with sight or the optic pathway.', from: 'Built out of: opt/o, vision' },
  facial: { say: 'FAY-shul', plain: 'To do with the face or facial nerve.', from: 'Built out of: faci/o, face' },
  vagus: { say: 'VAY-gus', plain: 'The wandering tenth cranial nerve, travelling through the chest and abdomen.', from: 'Built out of: vag/o, wander' },
};

const FINAL_BIG_BODY_NOTES = {
  annulus: { say: 'AN-yoo-lus', plain: 'A ring; the annulus fibrosus is the tough outer ring of an intervertebral disc.', from: 'Built out of: annul/o, ring' },
  pulposus: { say: 'pul-POH-sus', plain: 'Pulp-like; nucleus pulposus is the soft centre of an intervertebral disc.', from: 'Built out of: pulp/o, pulp' },
  meniscus: { say: 'meh-NIS-kus', plain: 'A crescent-shaped cartilage pad, especially in the knee.', from: 'Built out of: menisc/o, crescent' },
  labrum: { say: 'LAY-brum', plain: 'A rim of fibrocartilage that deepens a joint socket.', from: 'Built out of: labr/o, lip or rim' },
  retinaculum: { say: 'ret-ih-NAK-yoo-lum', plain: 'A retaining band that holds tendons close to a joint.', from: 'Built out of: retinacul/o, retainer' },
  enthesis: { say: 'en-THEE-sis', plain: 'The attachment site where tendon or ligament meets bone.', from: 'Built out of: enthes/o, insert or put in' },
  synovium: { say: 'sih-NOH-vee-um', plain: 'The lining of a synovial joint that helps produce synovial fluid.', from: 'Built out of: synovi/o, synovium' },
  cribriform: { say: 'KRIB-rih-form', plain: 'Sieve-like; the cribriform plate lets olfactory nerve fibres pass.', from: 'Built out of: cribr/o, sieve' },
  incisive: { say: 'in-SY-siv', plain: 'To do with the incisor region at the front of the jaw.', from: 'Built out of: incis/o, cut into' },
  ethmoidal: { say: 'eth-MOY-dul', plain: 'To do with the ethmoid bone between the eyes.', from: 'Built out of: ethmoid/o, sieve-like' },
  vertebrosternal: { say: 'ver-TEE-broh-STER-nul', plain: 'Running from a vertebra to the sternum.', from: 'Built out of: vertebr/o, vertebra + stern/o, sternum' },
  vertebrochondral: { say: 'ver-TEE-broh-KON-drul', plain: 'Running from a vertebra to costal cartilage.', from: 'Built out of: vertebr/o, vertebra + chondr/o, cartilage' },
  teresmajor: { say: 'TEER-eez MAY-jer', plain: 'The larger round muscle running from scapula toward the upper arm.', from: 'Built out of: teres, round + major, larger' },
  teresminor: { say: 'TEER-eez MY-ner', plain: 'The smaller round rotator-cuff muscle.', from: 'Built out of: teres, round + minor, smaller' },
  pectoralismajor: { say: 'pek-toh-RAL-iss MAY-jer', plain: 'The large superficial chest muscle.', from: 'Built out of: pector/o, chest + major, larger' },
  pectoralisminor: { say: 'pek-toh-RAL-iss MY-ner', plain: 'The smaller chest muscle deep to pectoralis major.', from: 'Built out of: pector/o, chest + minor, smaller' },
  pronatorquadratus: { say: 'proh-NAY-tor kwod-RAY-tus', plain: 'The square muscle that turns the palm downward.', from: 'Built out of: pronat/o, turn palm down + quadrat/o, square' },
  pronatorteres: { say: 'proh-NAY-tor TEER-eez', plain: 'The round muscle that turns the forearm into pronation.', from: 'Built out of: pronat/o, turn palm down + teres, round' },
  flexordigitorum: { say: 'FLEK-sor dij-ih-TOR-um', plain: 'A muscle that bends the fingers or toes.', from: 'Built out of: flex/o, bend + digit/o, finger or toe' },
  extensordigitorum: { say: 'ek-STEN-sor dij-ih-TOR-um', plain: 'A muscle that straightens the fingers or toes.', from: 'Built out of: extens/o, stretch out + digit/o, finger or toe' },
  palmaris: { say: 'pal-MAR-iss', plain: 'To do with the palm; palmaris longus is a forearm muscle.', from: 'Built out of: palm/o, palm' },
  flexorpollicis: { say: 'FLEK-sor POL-ih-siss', plain: 'A muscle that bends the thumb.', from: 'Built out of: flex/o, bend + pollic/o, thumb' },
  extensorpollicis: { say: 'ek-STEN-sor POL-ih-siss', plain: 'A muscle that straightens the thumb.', from: 'Built out of: extens/o, stretch out + pollic/o, thumb' },
  adductorpollicis: { say: 'ah-DUK-tor POL-ih-siss', plain: 'A muscle that brings the thumb toward the hand.', from: 'Built out of: ad-, toward + duct/o, lead + pollic/o, thumb' },
  opponenspollicis: { say: 'oh-POH-nenz POL-ih-siss', plain: 'A muscle that brings the thumb across the palm.', from: 'Built out of: oppon/o, oppose + pollic/o, thumb' },
  gluteusmaximus: { say: 'GLOO-tee-us MAK-sih-mus', plain: 'The largest buttock muscle.', from: 'Built out of: glute/o, buttock + maximus, largest' },
  gluteusmedius: { say: 'GLOO-tee-us MEE-dee-us', plain: 'The middle-sized buttock muscle, between maximus and minimus.', from: 'Built out of: glute/o, buttock + medi/o, middle' },
  gluteusminimus: { say: 'GLOO-tee-us MIN-ih-mus', plain: 'The smallest and deepest buttock muscle.', from: 'Built out of: glute/o, buttock + minimus, smallest' },
  tensorfasciaelatae: { say: 'TEN-sor FASH-ee-eye LAT-ee', plain: 'A muscle that tightens the broad fascia of the lateral thigh.', from: 'Built out of: tens/o, stretch + fasci/o, band + lat/o, broad' },
  tibialisanterior: { say: 'tib-ee-AL-iss an-TEER-ee-or', plain: 'A muscle beside the tibia at the front of the leg.', from: 'Built out of: tibi/o, tibia + anter/o, front' },
  tibialisposterior: { say: 'tib-ee-AL-iss pos-TEER-ee-or', plain: 'A muscle beside the tibia at the back of the leg.', from: 'Built out of: tibi/o, tibia + poster/o, back' },
  flexordigitorumlongus: { say: 'FLEK-sor dij-ih-TOR-um LONG-us', plain: 'The long muscle that bends the toes.', from: 'Built out of: flex/o, bend + digit/o, toe + longus, long' },
  extensordigitorumlongus: { say: 'ek-STEN-sor dij-ih-TOR-um LONG-us', plain: 'The long muscle that straightens the toes.', from: 'Built out of: extens/o, stretch out + digit/o, toe + longus, long' },
  flexorhallucislongus: { say: 'FLEK-sor HAL-yoo-siss LONG-us', plain: 'The long muscle that bends the great toe.', from: 'Built out of: flex/o, bend + halluc/o, great toe + longus, long' },
  extensorhallucislongus: { say: 'ek-STEN-sor HAL-yoo-siss LONG-us', plain: 'The long muscle that straightens the great toe.', from: 'Built out of: extens/o, stretch out + halluc/o, great toe + longus, long' },
  peroneuslongus: { say: 'per-oh-NEE-us LONG-us', plain: 'The long muscle along the fibular side of the leg.', from: 'Built out of: perone/o, fibula + longus, long' },
  peroneusbrevis: { say: 'per-oh-NEE-us BREH-viss', plain: 'The short muscle along the fibular side of the leg.', from: 'Built out of: perone/o, fibula + brevis, short' },
  pectineus: { say: 'pek-TIN-ee-us', plain: 'A comb-like muscle of the upper medial thigh.', from: 'Built out of: pectin/o, comb' },
  adductorlongus: { say: 'ah-DUK-tor LONG-us', plain: 'The long muscle that draws the thigh toward the midline.', from: 'Built out of: ad-, toward + duct/o, lead + longus, long' },
  adductorbrevis: { say: 'ah-DUK-tor BREH-viss', plain: 'The short muscle that draws the thigh toward the midline.', from: 'Built out of: ad-, toward + duct/o, lead + brevis, short' },
  vastuslateralis: { say: 'VAS-tus lat-er-AL-iss', plain: 'The broad quadriceps muscle on the outer thigh.', from: 'Built out of: vast/o, broad + later/o, side' },
  vastusmedialis: { say: 'VAS-tus mee-dee-AL-iss', plain: 'The broad quadriceps muscle on the inner thigh.', from: 'Built out of: vast/o, broad + medi/o, middle' },
  vastusintermedius: { say: 'VAS-tus in-ter-MEE-dee-us', plain: 'The broad quadriceps muscle lying between the other vasti.', from: 'Built out of: vast/o, broad + inter-, between + medi/o, middle' },
  fornix: { say: 'FOR-niks', plain: 'A curved fibre bundle in the brain.', from: 'Built out of: fornix, arch or vault' },
  claustrum: { say: 'KLAW-strum', plain: 'A thin sheet-like nucleus deep in the cerebral hemisphere.', from: 'Built out of: claustr/o, enclosure' },
  insula: { say: 'IN-soo-lah', plain: 'The island-like cortex hidden deep within the lateral sulcus.', from: 'Built out of: insul/o, island' },
  arborvitae: { say: 'AR-bor VY-tee', plain: 'The tree-like branching white matter inside the cerebellum.', from: 'Built out of: arbor, tree + vitae, life' },
