  cuboid: ['The cube-shaped lateral bone of the distal tarsal row.', '骰骨；立方骨'],
  cuneiform: ['Wedge-shaped; one of the three bones in front of the navicular.', '楔骨；楔形的'],
  rhomboid: ['A diamond-shaped muscle running from the spine to the medial border of the scapula.', '菱形肌；菱形的'],
  latissimus: ['The broad back muscle that pulls the upper limb down and back.', '背闊肌'],
  levator: ['A muscle whose main action is lifting a structure.', '提肌'],
  serratus: ['A saw-toothed muscle; serratus anterior lies along the ribs.', '鋸肌；鋸齒狀的'],
  tensor: ['A muscle that tightens or stretches a fascia or other structure.', '張肌'],
  fascia: ['A sheet or band of connective tissue wrapping and separating muscles.', '筋膜'],
  vastus: ['Broad; used in the names of the large quadriceps muscles.', '股四頭肌的廣肌；寬大的'],
  medialis: ['The medial one, nearer the body’s midline.', '內側的；內側肌'],
