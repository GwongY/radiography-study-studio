  infundibulum: ['A funnel-shaped passage or structure.', '漏斗；漏斗部'],
  ampulla: ['A widened flask-like section of a tube.', '壺腹'],
  isthmus: ['A narrow bridge joining two wider regions.', '峽部'],
  trigone: ['A triangular area; the bladder trigone lies between three openings.', '三角；膀胱三角'],
  ileocecal: ['To do with the junction between the ileum and caecum.', '迴盲的'],
  hepatopancreatic: ['To do with the liver and pancreas together.', '肝胰的'],
  sphincter: ['A ring muscle that closes an opening.', '括約肌'],
  papilla: ['A small nipple-like projection, such as a renal papilla.', '乳頭；乳頭狀突起'],
