  atlas: ['The first cervical vertebra, supporting the skull.', '寰椎'],
  axis: ['The second cervical vertebra, providing the pivot for head rotation.', '樞椎'],
  corpus: ['Body; used in anatomical names for a body-like main part.', '體；本體'],
  callosum: ['Tough or hard; corpus callosum is the fibre bridge between brain hemispheres.', '胼胝體的；胼胝體'],
  choroid: ['The vascular layer of the eye between the retina and sclera.', '脈絡膜'],
