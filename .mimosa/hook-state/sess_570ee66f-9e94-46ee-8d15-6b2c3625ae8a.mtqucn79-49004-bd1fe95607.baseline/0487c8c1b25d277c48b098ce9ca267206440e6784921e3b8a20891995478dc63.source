  sievert: ['The unit of radiation dose.', '希沃特（輻射劑量單位）'],
  roentgen: ['The unit of radiation, named after its discoverer.', '倫琴'],
  magnetic: ['To do with magnetism — as in magnetic resonance imaging.', '磁性的'],
  resonance: ['Vibration at a matching frequency — the MR in MRI.', '共振'],
  ultrasound: ['Sound too high to hear, used to image the body.', '超聲波'],
  tungsten: ['The metal target in an X-ray tube.', '鎢'],
  thermoluminescent: ['Glowing when heated — a type of dosimeter.', '熱發光的'],

  /* corpus sweep · round 2: remaining high-frequency terms */
  landmark: ['A recognizable feature on a bone or surface used to find the parts around it.', '解剖標誌'],
  process: ['A projection or outgrowth on a bone — e.g. spinous process, transverse process.', '突起'],
  distal: ['Further from the trunk or from the point of attachment — the opposite of proximal.', '遠端的'],
  radiation: ['Energy travelling as waves or particles; X-rays are ionizing radiation.', '輻射'],
  anatomical: ['To do with the structure of the body.', '解剖學的'],
  conducting: ['Carrying something along — the heart’s conducting system carries the electrical signal.', '傳導的'],
  immunity: ['The body’s ability to resist infection.', '免疫力'],
  ionizing: ['Radiation with enough energy to knock electrons out of atoms.', '游離的；電離的'],
  ionising: ['Radiation with enough energy to knock electrons out of atoms.', '游離的；電離的'],
  spinal: ['To do with the spine, or the spinal cord.', '脊椎的'],
  metacarpal: ['One of the five long bones of the hand, between wrist and fingers.', '掌骨'],
  capsule: ['The tough sleeve of tissue around a joint that holds it together.', '囊；關節囊'],
  tubercle: ['A small rounded bump on a bone where a muscle or tendon attaches.', '結節'],
  connective: ['Holding parts together — connective tissue supports and binds the body.', '結締的'],
  imaging: ['Making pictures of the inside of the body — X-ray, CT, MRI.', '影像'],
  plane: ['An imaginary flat surface used to describe the body, e.g. the median plane.', '平面'],
  systemic: ['To do with the whole body — the systemic circulation is the main loop round the body.', '全身的；體循環'],
  flexion: ['Bending a joint, decreasing the angle between two parts.', '屈曲'],
  nervous: ['To do with nerves and the nervous system.', '神經的'],
  contraction: ['The shortening of a muscle as it works.', '收縮'],
  facial: ['To do with the face.', '面部的'],
  rotation: ['Turning a body part around its own long axis.', '旋轉'],
  plasma: ['The liquid part of blood that carries the cells.', '血漿'],
  exposure: ['Being hit by radiation — or the radiation dose received.', '曝露'],
  rotator: ['Rotator cuff — the group of muscles that hold the shoulder joint in its socket.', '迴旋肌'],
  sensory: ['To do with the senses — carrying signals about what the body detects.', '感覺的'],
  bilateral: ['On both sides.', '雙側的'],
  midline: ['The imaginary line down the middle of the body.', '正中線'],
  receptor: ['A molecule or cell that detects a specific signal.', '感受器'],
  visceral: ['To do with the internal organs (the viscera).', '內臟的'],
  foramina: ['Holes in a bone — more than one foramen.', '孔；小孔'],
  innate: ['Innate immunity is the general, inborn defence you are born with.', '先天性的'],
  acromial: ['To do with the acromion — the outer tip of the shoulder blade.', '肩峰的'],
  inflammation: ['The redness, heat, swelling and pain response to damage or infection.', '炎症'],
  median: ['Down the middle — the median plane splits the body into equal left and right halves.', '中位'],
  mediastinum: ['The space in the middle of the chest between the two lungs, holding the heart and great vessels.', '縱隔'],
  temporomandibular: ['The jaw joint — the temporomandibular joint (TMJ).', '顳下頜的'],
  pericarditis: ['Inflammation of the pericardium, the bag around the heart.', '心包炎'],
  lymphocyte: ['A white blood cell that fights infection — T cells, B cells and NK cells are all lymphocytes.', '淋巴細胞'],


  /* ----------------------------------------------------------------- *
   * 2026 sweep — the cell, from the Lecture 1 items
   *
   * Eighteen lessons were written before this section existed, and 83 of
   * the technical words in them had no reading help at all: a lesson
   * could say "introns will be removed and exons spliced together" and
   * neither word was tappable and neither was defined anywhere. A term
   * the corpus USES has to be a term the corpus can EXPLAIN.
   * ----------------------------------------------------------------- */
  intron: ['A stretch inside a gene that is cut OUT of the RNA copy and thrown away — it does not code for any of the protein.', '內含子'],
  introns: ['The stretches inside a gene that are cut OUT of the RNA copy and thrown away.', '內含子'],
  exon: ['A stretch of a gene that is KEPT and joined to the others — the exons together carry the protein’s code. Exons EXit the nucleus.', '外顯子'],
  exons: ['The stretches of a gene that are kept and spliced together — they carry the protein’s code and leave the nucleus.', '外顯子'],
  splicing: ['Joining the kept pieces (exons) end to end after the discarded ones (introns) are cut out.', '剪接'],
  spliced: ['Joined end to end after the unwanted pieces were cut out.', '剪接'],
  transcription: ['Copying a gene from DNA into messenger RNA, inside the nucleus. Same alphabet, new copy.', '轉錄'],
  translation: ['Reading the messenger RNA at a ribosome and building the protein. A different alphabet — nucleic acid into protein.', '轉譯'],
  polymerase: ['The enzyme that builds a new nucleic-acid strand. RNA polymerase makes the messenger RNA.', '聚合酶'],
  promoter: ['The stretch of DNA in front of a gene where RNA polymerase binds to start copying it.', '啟動子'],
  codon: ['Three bases in a row — one codon spells one amino acid.', '密碼子'],
  cytosol: ['The fluid part of the cytoplasm, with the organelles sitting in it.', '細胞質基質'],
  organelle: ['A structure inside a cell with its own job — a little organ for the cell.', '細胞器'],
  organelles: ['The structures inside a cell, each with its own job.', '細胞器'],
  golgi: ['The Golgi apparatus — stacks of flattened membranes that store, alter and package what the cell exports.', '高爾基體'],
  cisternae: ['The flattened membrane sacs a Golgi apparatus is stacked from.', '扁囊'],
  cisterna: ['One flattened membrane sac of a Golgi apparatus.', '扁囊'],
  lysosome: ['A bag of digestive enzymes the cell uses to break things down.', '溶酶體'],
  lysosomes: ['Bags of digestive enzymes the cell uses to break things down.', '溶酶體'],
  peroxisome: ['A bag of enzymes that breaks down fats and then neutralises the toxins that produces.', '過氧化物酶體'],
  peroxisomes: ['Bags of enzymes that break down fats and neutralise the toxins that produces.', '過氧化物酶體'],
  cytoskeleton: ['The protein filaments and tubes that give a cell its shape and move things about inside it.', '細胞骨架'],
  microfilament: ['The thinnest cytoskeleton fibre. Microvilli are stiffened by these.', '微絲'],
  microfilaments: ['The thinnest cytoskeleton fibres — they stiffen microvilli.', '微絲'],
  microvilli: ['Tiny finger-like folds of the cell surface that multiply its area for absorbing.', '微絨毛'],
  cilium: ['A hair-like projection. A primary cilium senses; motile cilia sweep things along.', '纖毛'],
  cilia: ['Hair-like projections — one kind senses, the other sweeps material over the surface.', '纖毛'],
  centriole: ['A barrel of nine microtubule triplets that helps pull the chromosomes apart when a cell divides.', '中心粒'],
  centrioles: ['Barrels of nine microtubule triplets that help pull chromosomes apart in cell division.', '中心粒'],
  centrosome: ['The region holding the two centrioles; it organises the cell’s microtubules.', '中心體'],
  nucleolus: ['The dense body inside the nucleus that builds ribosome parts.', '核仁'],
  nucleoli: ['The dense bodies inside the nucleus that build ribosome parts.', '核仁'],
  nucleoplasm: ['The fluid inside the nucleus.', '核質'],
  nucleosome: ['DNA wound around a bundle of histone proteins — the first level of packing.', '核小體'],
  nucleosomes: ['DNA wound around histone proteins — the first level of packing.', '核小體'],
  histone: ['A protein that DNA coils around to pack itself away.', '組蛋白'],
  histones: ['The proteins DNA coils around to pack itself away.', '組蛋白'],
  chromatin: ['DNA in its loose, working state, before it condenses into a visible chromosome.', '染色質'],
  chromatid: ['One of the two identical copies of a chromosome, still joined at the centromere.', '染色單體'],
  chromatids: ['The two identical copies of a chromosome, still joined at the centromere.', '染色單體'],
  centromere: ['The waist where two sister chromatids are joined.', '著絲粒'],
  kinetochore: ['The protein plate on the centromere that the pulling fibres attach to.', '動粒'],
  mitosis: ['The division that splits the genetic material equally — one cell into two identical body cells.', '有絲分裂'],
  meiosis: ['The two-step division that makes sperm and eggs, in the gonads only.', '減數分裂'],
  cytokinesis: ['Splitting the cytoplasm and organelles in two — the step AFTER mitosis has divided the DNA.', '胞質分裂'],
  gamete: ['A sex cell — a sperm or an egg.', '配子'],
  gametes: ['The sex cells — sperm and eggs.', '配子'],
  gonad: ['An organ that makes sex cells — an ovary or a testis.', '性腺'],
  gonads: ['The organs that make sex cells — the ovaries and testes.', '性腺'],
  oocyte: ['The cell that develops into an egg.', '卵母細胞'],
  somatic: ['Of the body — every cell except the sex cells.', '體細胞的'],
  phospholipid: ['The two-tailed fat molecule the cell membrane is built from — a water-loving head and two water-fearing tails.', '磷脂'],
  hydrophilic: ['Water-loving — it faces the watery side.', '親水的'],
  hydrophobic: ['Water-fearing — it hides inside the membrane, away from water.', '疏水的'],
  glycocalyx: ['The sugary coat on the outside of the cell membrane.', '醣萼'],
  glycolipid: ['A fat with a sugar attached, sitting in the outer face of the membrane.', '醣脂'],
  glycolipids: ['Fats with sugars attached, in the outer face of the membrane.', '醣脂'],
  enzyme: ['A protein that speeds up a chemical reaction without being used up.', '酶'],
  enzymes: ['Proteins that speed up chemical reactions without being used up.', '酶'],
  stimulus: ['The change that sets a response going.', '刺激'],
  effector: ['The part that carries out the instruction — the muscle or gland that acts.', '效應器'],
  feedback: ['The response looping back to affect the thing that caused it. Negative feedback cancels the change; positive feedback amplifies it.', '反饋'],
  squamous: ['Thin and flat, like a scale.', '鱗狀的'],
  cuboidal: ['Square in cross-section, about as tall as it is wide.', '立方狀的'],
  columnar: ['Tall and narrow, like a column.', '柱狀的'],
  stratified: ['In several layers.', '複層的'],
  epithelia: ['The sheets of cells lining surfaces — plural of epithelium.', '上皮組織'],
  glandular: ['To do with a gland — a structure that secretes.', '腺體的'],
  exocrine: ['Secreting through a duct onto a surface.', '外分泌的'],
  erythrocyte: ['A red blood cell — it carries oxygen.', '紅血球'],
  erythrocytes: ['The red blood cells — they carry oxygen.', '紅血球'],
  leukocyte: ['A white blood cell — it defends against infection.', '白血球'],
  leukocytes: ['The white blood cells — they defend against infection.', '白血球'],
  platelet: ['A fragment of cytoplasm in the blood that plugs damage and starts clotting.', '血小板'],
  platelets: ['Cytoplasm fragments in the blood that plug damage and start clotting.', '血小板'],
  neuroglia: ['The supporting cells of nervous tissue — they feed and repair the neurons rather than signalling themselves.', '神經膠質'],

  /* ----------------------------------------------------------------- *
   * 2026 sweep — bone, muscle and the tissues of movement
   * ----------------------------------------------------------------- */
  osteocyte: ['A mature bone cell, walled into the matrix in its own little chamber.', '骨細胞'],
  osteocytes: ['The mature bone cells, walled into the matrix in their own chambers.', '骨細胞'],
  osteoblast: ['The bone-BUILDING cell — it lays down new matrix. Blast builds.', '成骨細胞'],
  osteoblasts: ['The bone-building cells — they lay down new matrix.', '成骨細胞'],
  osteoclast: ['The bone-BREAKING cell — it dissolves matrix and releases the minerals. Clast cracks.', '破骨細胞'],
  osteoclasts: ['The bone-breaking cells — they dissolve matrix and release minerals.', '破骨細胞'],
  osteoprogenitor: ['The stem cell that bone-building cells come from.', '骨祖細胞'],
  lacuna: ['The small chamber in bone matrix that one osteocyte lives in.', '骨陷窩'],
  lacunae: ['The small chambers in bone matrix that the osteocytes live in.', '骨陷窩'],
  canaliculi: ['The tiny channels joining the lacunae — the only route nutrients and waste can take through solid bone.', '骨小管'],
  hydroxyapatite: ['The calcium mineral that makes up two thirds of bone matrix — strong, but it shatters on its own.', '羥磷灰石'],
  collagen: ['The tough, flexible protein fibre that makes up the other third of bone, and most of tendon and ligament.', '膠原蛋白'],
  trabeculae: ['The web of little struts that spongy bone is built from.', '骨小樑'],
  haematopoietic: ['Blood-making — haematopoietic stem cells become red cells, white cells and platelets.', '造血的'],
  hematopoietic: ['Blood-making — the American spelling of haematopoietic.', '造血的'],
  mesenchymal: ['Of the loose embryonic connective tissue — mesenchymal stem cells can still become cartilage, bone, fat or muscle.', '間充質的'],
  epimysium: ['The sheath around the WHOLE muscle. Epi- = upon.', '肌外膜'],
  perimysium: ['The sheath around each BUNDLE of fibres. Peri- = around.', '肌束膜'],
  endomysium: ['The sheath around ONE fibre. Endo- = within.', '肌內膜'],
  fascicle: ['A bundle of muscle fibres, wrapped in perimysium.', '肌束'],
  fascicles: ['The bundles of muscle fibres, each wrapped in perimysium.', '肌束'],
  myofibrils: ['The rods of contractile filaments running the length of a muscle fibre.', '肌原纖維'],
  myocyte: ['A muscle cell — for skeletal muscle, a muscle fibre.', '肌細胞'],
  actin: ['The thin filament the myosin heads pull on.', '肌動蛋白'],
  convergent: ['Coming together — fascicles spread over a broad area converging on one thick tendon, so the muscle looks triangular.', '匯聚的'],
  fusiform: ['Spindle-shaped — thick in the middle, tapering to each tendon.', '梭形的'],
  pennate: ['Feather-shaped — short fibres set at an angle along a tendon, so more of them fit in.', '羽狀的'],
  unipennate: ['Feather-shaped with the fibres on ONE side of the tendon.', '單羽狀的'],
  bipennate: ['Feather-shaped with fibres on BOTH sides of a central tendon.', '雙羽狀的'],
  multipennate: ['Fibres coming in obliquely from many directions onto several tendons.', '多羽狀的'],
  myotendinous: ['Where muscle meets tendon.', '肌腱交界的'],
  osteotendinous: ['Where tendon meets bone.', '腱骨交界的'],
  synarthrosis: ['An IMMOVABLE joint. Syn- = joined together.', '不動關節'],
  amphiarthrosis: ['A SLIGHTLY movable joint. Amphi- = both, a bit of each.', '微動關節'],
  diarthrosis: ['A FREELY movable joint. Dia- = through; movement goes right through it.', '可動關節'],
  bursa: ['A small fluid-filled sac that cushions where a tendon rubs over bone.', '滑囊'],
  bursae: ['Small fluid-filled sacs that cushion where tendons rub over bone.', '滑囊'],
  articulation: ['A joint — the place two bones meet.', '關節'],
  articulations: ['The joints — the places bones meet.', '關節'],

  /* ----------------------------------------------------------------- *
   * The vocabulary of a bony landmark
   *
   * This is anatomy’s working vocabulary — a lecture says "the greater
   * tubercle" or "the nutrient foramen" and expects the noun to be
   * understood. None of it was tappable.
   * ----------------------------------------------------------------- */
  foramen: ['A hole through a bone, usually for a vessel or a nerve to pass.', '孔'],
  foramina: ['Holes through bone, for vessels or nerves to pass.', '孔'],
  fossa: ['A shallow hollow or depression in a bone.', '窩'],
  fossae: ['Shallow hollows in bone.', '窩'],
  sulcus: ['A groove. On bone, a furrow for a vessel; on the brain, the dip between two gyri.', '溝'],
  sulci: ['Grooves — furrows on bone, or the dips between the brain’s ridges.', '溝'],
  gyrus: ['A ridge on the surface of the brain.', '腦回'],
  gyri: ['The ridges on the surface of the brain.', '腦回'],
  condyle: ['A rounded knuckle at the end of a bone that forms a joint.', '髁'],
  condyles: ['The rounded knuckles at the ends of bones that form joints.', '髁'],
  epicondyle: ['The bump just above a condyle — a muscle attachment, not part of the joint.', '上髁'],
  tubercle: ['A small rounded bump on a bone, for something to attach to.', '結節'],
  tuberosity: ['A larger rough bump on a bone, for a big tendon to attach to.', '粗隆'],
  trochanter: ['One of the two large bumps on the femur where the hip muscles attach.', '轉子'],
  crest: ['A long ridge on a bone — the iliac crest is the top edge of the hip bone.', '嵴'],
  facet: ['A small smooth flat surface where one bone meets another.', '關節面'],
  meatus: ['A tube-like canal — the external acoustic meatus is the ear canal.', '道'],
  hilum: ['The doorway of an organ, where its vessels and nerves enter and leave.', '門'],
  lamina: ['A flat plate of bone — on a vertebra, the plate roofing the spinal canal.', '椎板'],
  laminae: ['Flat plates of bone.', '椎板'],
  pedicle: ['The short stalk joining the body of a vertebra to its arch.', '椎弓根'],
  ala: ['A wing-shaped part of a bone.', '翼'],
  cornu: ['A horn-shaped projection.', '角'],
  ramus: ['A branch, or the branch-like part of a bone — as in the ramus of the mandible.', '支'],
  rami: ['Branches, or the branch-like parts of bones.', '支'],
  process: ['A projection sticking out of a bone.', '突'],
  aponeurosis: ['A flat, sheet-like tendon.', '腱膜'],
  periosteum: ['The fibrous skin covering the outside of a bone, except at the joint surfaces.', '骨膜'],
  medullary: ['Of the marrow cavity in the middle of a bone.', '髓的'],
  diaphysis: ['The shaft of a long bone.', '骨幹'],
  epiphysis: ['The end of a long bone.', '骨骺'],
  metaphysis: ['The flared part between the shaft and the end of a long bone.', '幹骺端'],

  /* ---------------- Gap fill — useful meaning without forced pronunciation ---------------- */
  central: ['Near the middle; the central nervous system is the brain and spinal cord.', '中央的'],
  specific: ['Limited to one particular target, structure, or condition.', '特定的'],
  functional: ['To do with what a structure does rather than what it looks like.', '功能的'],
  potential: ['A stored difference in electrical charge that can drive a signal.', '電位；潛能'],
  asymmetric: ['Not matching from one side to the other.', '不對稱的'],
  clinical: ['Related to a patient, diagnosis, or healthcare practice.', '臨床的'],
  terminal: ['At the end of a structure or pathway.', '末端的'],
  structural: ['To do with the form, arrangement, or physical parts of something.', '結構的'],
  abnormal: ['Different from the usual or expected pattern.', '異常的'],
  classical: ['Traditional or established as the standard example.', '經典的；傳統的'],
  electrical: ['To do with electric charge, current, or signals.', '電的；電氣的'],
  histamine: ['A chemical signal involved in inflammation and allergic responses.', '組織胺'],
  genetic: ['To do with genes or DNA and the traits they carry.', '遺傳的；基因的'],
  synaptic: ['To do with a synapse, where one neuron communicates with another cell.', '突觸的'],
  bacteria: ['Single-celled organisms; some cause disease and others are harmless or useful.', '細菌'],
  elastic: ['Able to stretch and return toward its original shape.', '有彈性的'],
  kinase: ['An enzyme that transfers a phosphate group to another molecule.', '激酶'],
  mitochondria: ['Organelles that make much of a cell’s usable energy as ATP.', '粒線體'],
  molecule: ['Two or more atoms joined by chemical bonds.', '分子'],
  acetylcholine: ['A neurotransmitter used at the neuromuscular junction and many synapses.', '乙醯膽鹼'],
  aerobic: ['Requiring or using oxygen.', '有氧的'],
  peripheral: ['Outside the central part; the peripheral nervous system lies outside the brain and spinal cord.', '周邊的'],
  phospholipase: ['An enzyme that cuts phospholipids in a cell membrane.', '磷脂酶'],
  pyramidal: ['Pyramid-shaped or related to the pyramidal motor pathways.', '錐體的'],
  vaccine: ['A preparation that trains the immune system to recognise a threat.', '疫苗'],
  equilibrium: ['A balanced state in which opposing changes cancel each other.', '平衡'],
  ryanodine: ['A compound used to identify the calcium-release channel in muscle cells.', '魚尼丁'],
  chemotaxis: ['Movement toward or away from a chemical signal.', '趨化性'],
  homeostatic: ['Maintaining a stable internal state despite outside changes.', '維持內穩態的'],
  thyroxine: ['The thyroid hormone T4, which helps regulate metabolic rate.', '甲狀腺素'],
  tyrosine: ['An amino acid used to make proteins and several hormones and neurotransmitters.', '酪胺酸'],
  retinal: ['To do with the retina, the light-sensitive layer at the back of the eye.', '視網膜的'],
  collagenous: ['Rich in collagen, the tough structural protein of connective tissue.', '含膠原的'],
  disynaptic: ['Involving two synapses in the route from the first neuron to the last.', '雙突觸的'],
  genomic: ['To do with the complete genetic material of an organism or cell.', '基因組的'],
  nicotinic: ['A type of acetylcholine receptor activated by nicotine or acetylcholine.', '菸鹼型的'],
  talocrural: ['To do with the ankle joint between the tibia, fibula, and talus.', '脛距的'],
  atpase: ['An enzyme that breaks down ATP and releases usable energy.', 'ATP酶'],
  caudal: ['Toward the tail end; in humans, toward the lower end of the body.', '尾側的'],
  dopamine: ['A neurotransmitter involved in movement, motivation, and reward.', '多巴胺'],
  fascia: ['A sheet of connective tissue surrounding or separating muscles and organs.', '筋膜'],
  lactic: ['To do with lactate or lactic acid, produced during some forms of metabolism.', '乳酸的'],
  lobule: ['A small subdivision of a lobe.', '小葉'],
  phrenic: ['To do with the diaphragm; the phrenic nerve drives it.', '膈的'],
  precentral: ['In front of the central sulcus; the precentral gyrus contains primary motor cortex.', '中央前的'],

  /* ---------------- Larger coverage pass — common anatomy and physiology words ---------------- */
  muscle: ['A contractile tissue that produces force and movement.', '肌肉'],
  muscles: ['Contractile tissues that produce force and movement.', '肌肉'],
  tissue: ['A group of similar cells working together in a body structure.', '組織'],
  tissues: ['Groups of similar cells working together in body structures.', '組織'],
  movement: ['A change in position of the body or one of its parts.', '運動；移動'],
  movements: ['Changes in position of the body or one of its parts.', '運動；移動'],
  structure: ['A body part or the way a body part is arranged.', '結構'],
  structures: ['Body parts or the ways body parts are arranged.', '結構'],
  system: ['A group of organs or structures working together.', '系統'],
  systems: ['Groups of organs or structures working together.', '系統'],
  protein: ['A large molecule that forms cell parts or carries out cell functions.', '蛋白質'],
  proteins: ['Large molecules that form cell parts or carry out cell functions.', '蛋白質'],
  position: ['The place or orientation of a body part.', '位置；姿勢'],
  fibres: ['Long, thread-like strands in a tissue or cell.', '纖維'],
  joints: ['Places where two or more bones meet.', '關節'],
  region: ['A defined area of the body.', '區域'],
  regions: ['Defined areas of the body.', '區域'],
  surface: ['The outside or boundary layer of a structure.', '表面'],
  surfaces: ['The outside or boundary layers of structures.', '表面'],
  response: ['A reaction to a stimulus or signal.', '反應'],
  responses: ['Reactions to stimuli or signals.', '反應'],
  pathway: ['A route followed by a signal, substance, or process.', '途徑；通路'],
  pathways: ['Routes followed by signals, substances, or processes.', '途徑；通路'],
  action: ['The effect or movement produced by a structure or process.', '作用；動作'],
  attachment: ['A place where a tissue, especially a muscle or tendon, joins another structure.', '附著點'],
  effect: ['A change produced by a cause, signal, or treatment.', '作用；效果'],
  material: ['The substance making up a structure or surrounding cells.', '物質；材料'],
  oxygen: ['A gas needed by cells for efficient energy production.', '氧氣'],
  transmitter: ['A chemical messenger released by a nerve cell.', '傳遞物；神經遞質'],
  volume: ['The amount of space occupied by a substance or structure.', '體積；容量'],
  binding: ['Attaching to another molecule or structure.', '結合'],
  socket: ['A cup-shaped hollow that receives the rounded end of a bone.', '關節窩'],
  shoulder: ['The region where the upper limb joins the trunk.', '肩部'],
  exchange: ['The movement of substances between two spaces or systems.', '交換'],
  supply: ['The delivery of blood, oxygen, nerves, or another resource to a structure.', '供應'],
  insertion: ['The attachment point of a muscle or tendon, usually on the more movable structure.', '止點；附著點'],
  nerves: ['Bundles of nerve fibres carrying signals to or from the central nervous system.', '神經'],
  tracts: ['Bundles of nerve fibres travelling together inside the central nervous system.', '神經束；傳導束'],
