  abdominis: ['Of the abdomen; used in names of abdominal muscles.', '腹部的'],
  transversus: ['Running across or transverse; used for muscles crossing the body.', '橫的；橫肌'],
  oblique: ['Slanting or running at an angle.', '斜的；斜肌'],
  multifidus: ['A deep back muscle made of many short, divided fascicles.', '多裂肌'],
  splenius: ['A band-like muscle of the back of the neck.', '夾肌'],
  scalene: ['One of the sloping neck muscles that form the scalene group.', '斜角肌；斜角的'],
  digastric: ['A muscle with two bellies joined by an intermediate tendon.', '二腹肌；二腹的'],
