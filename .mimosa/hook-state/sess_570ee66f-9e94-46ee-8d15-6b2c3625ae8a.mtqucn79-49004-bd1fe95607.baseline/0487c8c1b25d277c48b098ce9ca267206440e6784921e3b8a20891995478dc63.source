  masseter: ['A major muscle of chewing at the side of the jaw.', '咬肌'],
  carina: ['A keel-like ridge at the point where the trachea divides into main bronchi.', '隆嵴；氣管隆嵴'],
  epicardium: ['The outer layer of the heart wall.', '心外膜'],
  pericardial: ['To do with the sac or tissues around the heart.', '心包的'],
  pleural: ['To do with the pleura or the membranes around the lungs.', '胸膜的'],
  bronchopulmonary: ['Relating to the bronchi and lungs together.', '支氣管肺的'],
  tracheobronchial: ['Relating to the trachea and bronchi together.', '氣管支氣管的'],
