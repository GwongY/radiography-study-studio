  maxillary: ['To do with the maxilla, the upper jaw bone.', '上頜的'],
  mandibular: ['To do with the mandible, the lower jaw bone.', '下頜的'],
  endosteum: ['The membrane lining the inner surfaces of bone.', '骨內膜'],
