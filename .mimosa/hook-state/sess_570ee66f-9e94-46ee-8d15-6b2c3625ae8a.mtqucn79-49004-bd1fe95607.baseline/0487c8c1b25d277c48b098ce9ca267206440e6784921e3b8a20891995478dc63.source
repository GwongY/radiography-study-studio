  acromion: ['The highest outer projection of the scapula, forming the shoulder roof.', '肩峰'],
  coracoid: ['A beak-shaped projection from the scapula.', '喙突；喙突的'],
  trochanter: ['A large projection of the femur where hip muscles attach.', '轉子'],
  tuberosity: ['A large rough projection on a bone for tendon or muscle attachment.', '粗隆'],
  epicondyle: ['A projection above a condyle, usually serving as an attachment site.', '上髁'],
  foramen: ['A hole or opening through bone for a nerve or vessel.', '孔'],
  fossa: ['A shallow hollow or depression.', '窩'],
  sulcus: ['A groove or furrow; in the brain, a groove between gyri.', '溝'],
  gyrus: ['A ridge or raised fold on the surface of the brain.', '腦回'],
  meatus: ['A canal or passage, such as the external acoustic meatus.', '道；管'],
  hilum: ['An organ’s entry and exit point for vessels, nerves, or ducts.', '門；肺門；腎門'],
  lamina: ['A thin plate; a vertebral lamina helps form the roof of the spinal canal.', '板；椎板'],
