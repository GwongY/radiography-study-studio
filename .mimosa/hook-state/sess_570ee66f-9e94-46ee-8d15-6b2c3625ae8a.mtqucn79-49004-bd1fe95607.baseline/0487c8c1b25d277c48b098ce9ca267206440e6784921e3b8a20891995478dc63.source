  ramus: ['A branch-like part of a structure, such as the mandibular ramus.', '支；分支'],
  aponeurosis: ['A broad, flat sheet of tendon.', '腱膜'],
  periosteum: ['The tough connective-tissue covering on the outer surface of bone.', '骨膜'],
  symphysis: ['A midline joint in which the two sides are joined by fibrocartilage.', '聯合'],
  costochondral: ['Relating to a rib and its costal cartilage.', '肋軟骨的'],
  sacrococcygeal: ['Relating to the sacrum and coccyx together.', '骶尾的'],
  lumbosacral: ['Relating to the lumbar region and sacrum together.', '腰骶的'],
  iliacus: ['A muscle in the iliac fossa that helps flex the hip.', '髂肌'],
