  myelencephalon: ['The developing brain division that gives rise to the medulla.', '髓腦'],
  prosencephalon: ['The forebrain division of the developing brain.', '前腦'],
  rhombencephalon: ['The hindbrain division of the developing brain.', '菱腦'],
  meninges: ['The three protective membranes around the brain and spinal cord.', '腦膜；脊髓膜'],
  dura: ['The tough outer layer of the meninges.', '硬腦膜；硬膜'],
  pia: ['The delicate inner meningeal layer closely covering nervous tissue.', '軟腦膜；軟膜'],
  chiasm: ['A crossing of nerve fibres, such as at the optic chiasm.', '交叉；交叉部'],
  decussation: ['A crossing of nerve fibres from one side to the other.', '交叉；交叉部'],
  fasciculus: ['A small bundle of nerve fibres.', '纖維束'],
  peduncle: ['A stalk-like bundle connecting one brain region with another.', '腳；腦腳'],
  corticospinal: ['Running from the cerebral cortex to the spinal cord.', '皮質脊髓的'],
  spinothalamic: ['Running from the spinal cord toward the thalamus.', '脊髓丘腦的'],
  macula: ['A specialised spot or patch; in the retina it supports sharp central vision.', '斑；黃斑'],
