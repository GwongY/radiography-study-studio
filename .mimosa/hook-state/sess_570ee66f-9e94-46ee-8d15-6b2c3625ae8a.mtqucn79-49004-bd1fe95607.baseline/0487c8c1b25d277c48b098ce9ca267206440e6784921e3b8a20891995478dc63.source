  crista: ['A crest or ridge, such as crista galli in the skull.', '嵴；脊'],
  mastoid: ['To do with the breast-shaped process behind the ear.', '乳突的；乳突'],
  nuchal: ['To do with the nape or back of the neck.', '項部的'],
