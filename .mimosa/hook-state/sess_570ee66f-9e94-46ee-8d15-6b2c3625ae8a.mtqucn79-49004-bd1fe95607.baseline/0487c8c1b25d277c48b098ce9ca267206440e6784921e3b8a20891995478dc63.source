  ventricle: ['A small cavity; brain ventricles contain cerebrospinal fluid.', '腦室；心室'],
  cerebral: ['To do with the cerebrum, the large thinking part of the brain.', '大腦的'],
  cerebellar: ['To do with the cerebellum, which coordinates movement and balance.', '小腦的'],
  arachnoid: ['The spider-web-like middle layer of the meninges.', '蛛網膜'],
  meningeal: ['To do with the meninges around the brain and spinal cord.', '腦膜的'],
  subarachnoid: ['Beneath the arachnoid layer; cerebrospinal fluid occupies this space.', '蛛網膜下的'],
  trochlear: ['To do with the fourth cranial nerve, which moves an eye muscle.', '滑車神經的；滑車的'],
  trigeminal: ['To do with the fifth cranial nerve, with three major divisions.', '三叉神經的'],
  accessory: ['To do with the eleventh cranial nerve, assisting head and shoulder movement.', '副神經的'],
  subclavius: ['A small muscle lying beneath the clavicle.', '鎖骨下肌'],
  rotatores: ['Small deep back muscles that rotate the vertebral column.', '回旋肌'],
  semispinalis: ['A deep back muscle running partly along the spine.', '半棘肌'],
  longissimus: ['The longest column of the erector spinae muscle group.', '最長肌'],
