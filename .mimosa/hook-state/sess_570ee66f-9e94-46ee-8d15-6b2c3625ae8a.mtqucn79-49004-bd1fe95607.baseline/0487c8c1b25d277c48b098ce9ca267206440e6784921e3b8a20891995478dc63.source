  sinoatrial: ['To do with the sinus node and atrium; the sinoatrial node starts the heartbeat.', '竇房的；竇房結的'],
  atrioventricular: ['Between an atrium and a ventricle.', '房室的；房室結的'],
  chordae: ['Cord-like strands; chordae tendineae tether heart valves to papillary muscles.', '腱索'],
  papillary: ['Nipple-shaped; papillary muscles anchor the heart-valve cords.', '乳頭肌的；乳頭狀的'],
  glomerulus: ['A tiny knot of capillaries where filtration begins in a nephron.', '腎小球'],
